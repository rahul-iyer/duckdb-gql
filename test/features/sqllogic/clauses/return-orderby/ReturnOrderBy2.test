# GQL-adapted source specification:
#   Scenario: [12] Aggregation of named paths
#     Given an empty graph
#     And having executed:
#       """
#       INSERT (a:A), (b:B), (c:C), (d:D), (e:E), (f:F)
#       INSERT (a)-[:R]->(b)
#       INSERT (c)-[:R]->(d)
#       INSERT (d)-[:R]->(e)
#       INSERT (e)-[:R]->(f)
#       """
#     When executing query:
#       """
#       MATCH p = (a)-[*]->(b)
#       RETURN collect(nodes(p)) AS paths, length(p) AS l
#       ORDER BY l
#       """
#     Then the result should be, in order (ignoring element order for lists):
#       | paths                                                    | l |
