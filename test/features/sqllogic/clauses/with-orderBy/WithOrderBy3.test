# Source: tck/features/clauses/with-orderBy/WithOrderBy3.feature:262 [7] The order direction cannot be overwritten
# Port status: pending
# Translation review flags: with_scope_translation,for_iteration
#
# GQL-adapted source specification:
#   Scenario Outline: [7] The order direction cannot be overwritten
#     Given any graph
#     When executing query:
#       """
#       FOR a IN [1, 2, 3]
#       LET __gql_with_scope_1 = 1, __gql_with_1_1_a = a
#         ORDER BY <sort>
#         LIMIT 1
#       RETURN a
#       """
#     Then the result should be, in any order:
#       | a       |
#       | <value> |
#     And no side effects
#
#     Examples:
#       | sort                  | value |
#       | a ASC, a DESC         | 1     |
#       | a + 2 ASC, a + 2 DESC | 1     |
#       | a * a ASC, a * a DESC | 1     |
#       | a ASC, -1 * a ASC     | 1     |
#       | -1 * a DESC, a ASC    | 1     |
#       | a DESC, a ASC         | 3     |
#       | a + 2 DESC, a + 2 ASC | 3     |
#       | a * a DESC, a * a ASC | 3     |
#       | a DESC, -1 * a DESC   | 3     |
#       | -1 * a ASC, a DESC    | 3     |

# Source: tck/features/clauses/with-orderBy/WithOrderBy3.feature:290 [8] Fail on sorting by any number of undefined variables in any position #Example: <exampleName>
# Port status: pending
# Translation review flags: with_scope_translation
#
# GQL-adapted source specification:
#   Scenario Outline: [8] Fail on sorting by any number of undefined variables in any position #Example: <exampleName>
#     Given any graph
#     When executing query:
#       """
#       LET __gql_with_scope_1 = 1, a = 1, b = 'b', c = 3, d = true
#       LET __gql_with_scope_2 = 1, __gql_with_2_1_a = a, __gql_with_2_2_b = b
#       LET __gql_with_scope_3 = 1, __gql_with_3_1_a = a
#         ORDER BY <sort>
#       RETURN a
#       """
#     Then a SyntaxError should be raised at compile time: UndefinedVariable
#
#     Examples:
#       | sort                | exampleName   |
#       | a, c                | out of scope  |
#       | a, c ASC            | out of scope  |
#       | a, c DESC           | out of scope  |
#       | a, c, d             | out of scope  |
#       | a, c ASC, d         | out of scope  |
#       | a, c DESC, d        | out of scope  |
#       | c, a, d             | out of scope  |
#       | c ASC, a, d         | out of scope  |
#       | c DESC, a, d        | out of scope  |
#       | c, d, a             | out of scope  |
#       | b, c, d, a          | out of scope  |
#       | c, b, c, d, a       | out of scope  |
#       | c, d, b, b, d, c, a | out of scope  |
#       | a, e                | never defined |
#       | a, e ASC            | never defined |
#       | a, e DESC           | never defined |
#       | a, e, f             | never defined |
#       | a, e ASC, f         | never defined |
#       | a, e DESC, f        | never defined |
#       | e, a, f             | never defined |
#       | e ASC, a, f         | never defined |
#       | e DESC, a, f        | never defined |
#       | e, f, a             | never defined |
#       | b, e, f, a          | never defined |
#       | e, b, e, f, a       | never defined |
#       | e, f, b, b, f, e, a | never defined |
#       | a, c, e             | mixed         |
#       | a, c, e, b          | mixed         |
#       | b, c, a, f, a       | mixed         |
#       | d, f, b, b, f, c, a | mixed         |
