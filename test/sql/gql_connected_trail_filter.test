# name: test/sql/gql_connected_trail_filter.test
# description: Complete-path trail filtering preserves bags, NULLs and optional correlation
# group: [gql]

require duckgql

query IIII
SELECT gql_trail_unique(1, 2, 3), gql_trail_unique(1, 2, 1),
       gql_trail_unique(1, NULL, 3), gql_trail_unique(0, 18446744073709551615::UBIGINT, 2)
----
true	false	false	true

# Exercise the general arity path, not just the three-edge specialization.
query III
SELECT gql_trail_unique(1, 2, 3, 4), gql_trail_unique(1, 2, 3, 1),
       gql_trail_unique(1, 2, 3, NULL)
----
true	false	false

# Multiple chunks, selected rows, NULLs, and repeated IDs must agree with
# ordinary relational inequality filtering.
query I
WITH inputs AS (
    SELECT i::UBIGINT a,
           CASE WHEN i % 7 = 0 THEN NULL ELSE i + 1 END::UBIGINT b,
           CASE WHEN i % 11 = 0 THEN i ELSE i + 2 END::UBIGINT c
    FROM range(12000) r(i) WHERE i % 5 <> 0
)
SELECT count(*) FROM inputs
WHERE gql_trail_unique(a, b, c) <> coalesce(a <> b AND a <> c AND b <> c, false)
----
0

statement ok
COPY (SELECT * FROM (VALUES ('a','N','a'), ('b','N','b')) v(":ID", ":LABEL", "name:string")) TO '__TEST_DIR__/connected_trail_nodes.csv' (HEADER, FORMAT CSV)

statement ok
COPY (SELECT * FROM (VALUES ('a','a','R'), ('a','a','R'), ('a','a','S'), ('a','a','T')) e(":START_ID", ":END_ID", ":TYPE")) TO '__TEST_DIR__/connected_trail_edges.csv' (HEADER, FORMAT CSV)

statement ok
CREATE GRAPH connected_trails ANY

statement ok
COPY GRAPH connected_trails FROM (VERTICES '__TEST_DIR__/connected_trail_nodes.csv', EDGES '__TEST_DIR__/connected_trail_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH connected_trails

statement ok
PRAGMA enable_profiling='query_tree'

statement ok
PRAGMA profiling_output='__TEST_DIR__/connected_trail_plan.txt'

# Two parallel R edges may be chosen in two orders. Independent paths may
# reuse an edge, but the long path must not reuse its own R edge.
query I
MATCH (a)-[:T]->(d), (a)-[:R]->(b)-[:S]->(c)-[:R]->(d)
RETURN count(*)
----
2

statement ok
PRAGMA disable_profiling

query I
SELECT contains(lower(content), 'gql_trail_unique')
FROM read_text('__TEST_DIR__/connected_trail_plan.txt')
----
true

query I
MATCH (a)-[:T]->(d), (a)-[:R]->(b)-[:S]->(c)-[:T]->(e)-[:R]->(d)
RETURN count(*)
----
2

# An unlabeled middle step may not reuse either of the two selected R edges.
query I
MATCH (a)-[:T]->(d), (a)-[:R]->(b)-[]->(c)-[:R]->(d)
RETURN count(*)
----
4

query I
MATCH (a)-[:T]->(d), (a)-[:R]-(b)-[:S]->(c)-[:R]-(d)
RETURN count(*)
----
8

query TI rowsort
MATCH (n:N)
OPTIONAL MATCH (n)-[:T]->(d), (n)-[:R]->(b)-[:S]->(c)-[:R]->(d)
RETURN n.name, count(d)
----
a	2
b	0

statement ok
BEGIN

query I
MATCH (a)-[:T]->(d), (a)-[:R]->(b)-[:S]->(c)-[:R]->(d)
RETURN count(*)
----
2

statement ok
ROLLBACK

statement ok
DROP GRAPH connected_trails
