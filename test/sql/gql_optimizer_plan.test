# name: test/sql/gql_optimizer_plan.test
# description: Fixed GQL plans expose native join islands to DuckDB's optimizer
# group: [gql]

require duckgql

statement ok
COPY (
    SELECT * FROM (VALUES
        ('1', 'Ada', 42, 'Person'),
        ('2', 'Grace', 35, 'Person'),
        ('3', 'Linus', 30, 'Person'),
        ('4', 'Edsger', 27, 'Person')
    ) vertices(":ID", "name:string", "age:int", ":LABEL")
) TO '__TEST_DIR__/gql_optimizer_vertices.csv' (FORMAT CSV, HEADER)

statement ok
COPY (
    SELECT * FROM (VALUES
        ('1', '2', 'KNOWS', 2020),
        ('2', '3', 'KNOWS', 2021),
        ('3', '4', 'KNOWS', 2022)
    ) edges(":START_ID", ":END_ID", ":TYPE", "since:int")
) TO '__TEST_DIR__/gql_optimizer_edges.csv' (FORMAT CSV, HEADER)

statement ok
CREATE GRAPH optimizer_plan ANY

statement ok
COPY GRAPH optimizer_plan FROM (
    VERTICES '__TEST_DIR__/gql_optimizer_vertices.csv',
    EDGES '__TEST_DIR__/gql_optimizer_edges.csv'
) FORMAT GRAPH

statement ok
SESSION SET GRAPH optimizer_plan

# A label-only MATCH over newly loaded storage must probe the native list
# directly. The physical filter must not reconstruct a list with string_split.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_native_label_list_plan.txt'

statement ok
MATCH (source:Person)
RETURN count(*)

statement ok
PRAGMA disable_profiling

query II
SELECT len(regexp_extract_all(lower(content), 'string_split')),
       len(regexp_extract_all(lower(content), 'list_contains'))
FROM read_text('__TEST_DIR__/gql_native_label_list_plan.txt')
----
0	1

# Profiling observes the physical tree after DuckDB statistics propagation and
# join ordering. Three mandatory MATCH stages must become one native join island:
# three vertex scans plus two edge scans, connected by four joins, with the
# gql_match_relational bind-replacement function completely absent.
statement ok
PRAGMA enable_profiling = 'query_tree_optimizer'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_mandatory_plan.txt'

statement ok
MATCH (source:Person)
MATCH (source)-[edge_one]->(middle:Person)
MATCH (middle)-[edge_two]->(destination:Person)
FILTER source.age = 42
RETURN source.name, middle.name, destination.name

statement ok
PRAGMA disable_profiling

query IIIII
SELECT
    len(regexp_extract_all(content, 'TABLE_SCAN')),
    len(regexp_extract_all(content, 'Join Type:')),
    len(regexp_extract_all(lower(content), 'gql_match_relational')),
    len(regexp_extract_all(content, 'Join Order:')),
    len(regexp_extract_all(content, 'Statistics Propagation:'))
FROM read_text('__TEST_DIR__/gql_mandatory_plan.txt')
----
5	4	0	1	1

# LEFT_APPLY is deliberately not part of the reorderable inner-join island.
# It must survive native lowering as exactly one left outer join barrier.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_optional_plan.txt'

statement ok
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[relationship]->(destination:Person)
RETURN source.name, destination.name

statement ok
PRAGMA disable_profiling

query I
SELECT len(regexp_extract_all(content, 'Join Type: LEFT'))
FROM read_text('__TEST_DIR__/gql_optional_plan.txt')
----
1

# Managed recursive paths keep their different-edge trail as native UBIGINT
# identities. This plan gate prevents a regression to per-edge VARCHAR casts.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_recursive_plan.txt'

statement ok
MATCH (source:Person)-[:KNOWS]->*(destination:Person)
RETURN destination.name

statement ok
PRAGMA disable_profiling

query II
SELECT
    contains(content, '(edge_ids, __gql_edge_id))'),
    contains(content, 'CAST(__gql_edge_id AS VARCHAR)')
FROM read_text('__TEST_DIR__/gql_recursive_plan.txt')
----
true	false

# DuckGQL queries use DuckDB's native EXPLAIN renderer after GQL lowering and
# bind replacement. The customer sees the physical managed-table plan rather
# than the gql_match_relational implementation boundary.
query II
EXPLAIN MATCH (person:Person)
WHERE person.age >= 35
RETURN person.name
----
physical_plan	<REGEX>:.*graph_1_vertices.*

query II
EXPLAIN ANALYZE MATCH (person:Person)
WHERE person.age >= 35
RETURN person.name
----
analyzed_plan	<REGEX>:.*graph_1_vertices.*

query II
EXPLAIN (FORMAT JSON) MATCH (person:Person)
RETURN person.name
----
physical_plan	<REGEX>:.*graph_1_vertices.*

statement ok
CALL gql_build_csr('optimizer_plan')

# A valid CSR snapshot also exposes its node-label posting lists. MATCH joins
# those IDs back to the authoritative vertex table and no longer evaluates
# list membership row by row.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_vertex_label_plan.txt'

query T
MATCH (source:Person) WHERE source.age = 42
RETURN source.name
----
Ada

statement ok
PRAGMA disable_profiling

query II
SELECT contains(lower(content), 'gql_csr_vertices'),
       contains(lower(content), 'list_contains')
FROM read_text('__TEST_DIR__/gql_csr_vertex_label_plan.txt')
----
true	false

# A fixed labeled hop whose source was bound by an earlier MATCH stage uses
# connection-local CSR expansion. Vertex/property work remains in DuckDB.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_fixed_hop_plan.txt'

query TT rowsort
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[:KNOWS]->(destination:Person)
RETURN source.name, destination.name
----
Ada	Grace

statement ok
PRAGMA disable_profiling

query III
SELECT contains(lower(content), 'gql_csr_expand'),
       contains(lower(content), 'graph_1_edges'),
       contains(lower(content), 'gql_vertex_fetch')
FROM read_text('__TEST_DIR__/gql_csr_fixed_hop_plan.txt')
----
true	false	true

# A same-stage topology chain uses CSR only for its selective first frontier.
# The next edge remains relational so DuckDB can scan and reorder the broad
# frontier in bulk instead of nesting lateral delimiter joins.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_bulk_frontier_plan.txt'

query TTT rowsort
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[:KNOWS]->{1,2}(middle:Person),
      (middle)-[:KNOWS]->(destination:Person)
RETURN source.name, middle.name, destination.name
----
Ada	Grace	Linus
Ada	Linus	Edsger

statement ok
PRAGMA disable_profiling

query III
SELECT contains(lower(content), 'gql_csr_path_expand'),
       contains(lower(content), 'graph_1_edges'),
       contains(lower(content), 'gql_vertex_fetch')
FROM read_text('__TEST_DIR__/gql_csr_bulk_frontier_plan.txt')
----
true	false	false

# Returning the complete edge value uses CSR to generate candidate edge IDs,
# then directly fetches their authoritative canonical rows.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_edge_value_fallback_plan.txt'

statement ok
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[relationship:KNOWS]->(destination:Person)
RETURN relationship

statement ok
PRAGMA disable_profiling

query III
SELECT contains(lower(content), 'gql_csr_expand'),
       contains(lower(content), 'graph_1_edges'),
       contains(lower(content), 'gql_edge_fetch')
FROM read_text('__TEST_DIR__/gql_csr_edge_value_fallback_plan.txt')
----
true	false	true

# A scalar edge-property predicate uses the same hybrid path and reads the
# property from canonical storage after CSR candidate generation.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_edge_property_plan.txt'

query TI
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[relationship:KNOWS]->(destination:Person)
WHERE relationship.since = 2020
RETURN destination.name, relationship.since
----
Grace	2020

statement ok
PRAGMA disable_profiling

query III
SELECT contains(lower(content), 'gql_csr_expand'),
       contains(lower(content), 'graph_1_edges'),
       contains(lower(content), 'gql_edge_fetch')
FROM read_text('__TEST_DIR__/gql_csr_edge_property_plan.txt')
----
true	false	true

query II
EXPLAIN CALL algo.degree('optimizer_plan')
YIELD vertex_id, total_degree
RETURN vertex_id, total_degree
----
physical_plan	<REGEX>:.*Function: DEGREE.*

# Any direct table write invalidates the connection-local snapshot. Ordinary
# MATCH then safely falls back instead of requiring CSR or reading stale data.
statement ok
UPDATE gql_data.graph_1_edges SET __gql_type = __gql_type WHERE false

statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_stale_fallback_plan.txt'

statement ok
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[:KNOWS]->(destination:Person)
RETURN destination.name

statement ok
PRAGMA disable_profiling

query II
SELECT contains(lower(content), 'gql_csr_expand'),
       contains(lower(content), 'gql_csr_vertices')
FROM read_text('__TEST_DIR__/gql_csr_stale_fallback_plan.txt')
----
false	false

# Posting access requires both a point-like property predicate and a selective
# label. Label-only scans remain ordinary native-list scans.
statement ok
COPY (
    SELECT CAST(i AS VARCHAR) AS ":ID",
           CASE WHEN i = 1 THEN 'Person;Rare' ELSE 'Person' END AS ":LABEL",
           CAST(i AS INTEGER) AS "metric:int"
    FROM range(1, 2049) values(i)
) TO '__TEST_DIR__/gql_selectivity_vertices.csv' (FORMAT CSV, HEADER)

statement ok
COPY (
    SELECT '1' AS ":START_ID", '2' AS ":END_ID", 'LINK' AS ":TYPE"
) TO '__TEST_DIR__/gql_selectivity_edges.csv' (FORMAT CSV, HEADER)

statement ok
CREATE GRAPH label_selectivity ANY

statement ok
COPY GRAPH label_selectivity FROM (
    VERTICES '__TEST_DIR__/gql_selectivity_vertices.csv',
    EDGES '__TEST_DIR__/gql_selectivity_edges.csv'
) FORMAT GRAPH

statement ok
SESSION SET GRAPH label_selectivity

statement ok
CALL gql_build_csr('label_selectivity')

statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_broad_label_plan.txt'

query I
MATCH (:Person)
RETURN count(*)
----
2048

statement ok
PRAGMA disable_profiling

query II
SELECT contains(lower(content), 'gql_csr_vertices'),
       contains(lower(content), 'list_contains')
FROM read_text('__TEST_DIR__/gql_csr_broad_label_plan.txt')
----
false	true

# Even with a literal equality predicate, a broad label whose exact posting
# cardinality exceeds the optimizer threshold remains a native-list scan.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_broad_point_label_plan.txt'

query I
MATCH (person:Person) WHERE person.metric = 1
RETURN count(*)
----
1

statement ok
PRAGMA disable_profiling

query II
SELECT contains(lower(content), 'gql_csr_vertices'),
       contains(lower(content), 'list_contains')
FROM read_text('__TEST_DIR__/gql_csr_broad_point_label_plan.txt')
----
false	true

# A selective label plus a literal equality predicate chooses its exact CSR
# posting and eliminates row-by-row label membership evaluation.
statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_csr_selective_label_plan.txt'

query I
MATCH (rare:Rare) WHERE rare.metric = 1
RETURN count(*)
----
1

statement ok
PRAGMA disable_profiling

query II
SELECT contains(lower(content), 'gql_csr_vertices'),
       contains(lower(content), 'list_contains')
FROM read_text('__TEST_DIR__/gql_csr_selective_label_plan.txt')
----
true	false

# A rebuilt CSR may still accelerate topology after a direct SQL write changes
# the canonical-to-physical edge-ID mapping. The optimizer must keep canonical
# edge properties on the scan fallback instead of deriving an invalid row ID.
statement ok
SESSION SET GRAPH optimizer_plan

statement ok
UPDATE gql_data.graph_1_edges
SET __gql_edge_id = 10
WHERE __gql_edge_id = 1

statement ok
CALL gql_build_csr('optimizer_plan')

statement ok
PRAGMA enable_profiling = 'query_tree'

statement ok
PRAGMA profiling_output = '__TEST_DIR__/gql_edge_fetch_layout_fallback_plan.txt'

query TI
MATCH (source:Person) WHERE source.age = 42
MATCH (source)-[relationship:KNOWS]->(destination:Person)
WHERE relationship.since = 2020
RETURN destination.name, relationship.since
----
Grace	2020

