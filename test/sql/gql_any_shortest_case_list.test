# name: test/sql/gql_any_shortest_case_list.test
# description: ANY SHORTEST distances, searched CASE, and list values, with answers worked out by hand
# group: [gql]

require duckgql

# 1 -> 2 (twice), 1 -> 3, 2 -> 3, 3 -> 4, 3 -> 1, 4 -> 5. Vertex 6 is unreachable. 4 is also Q.
statement ok
COPY (SELECT * FROM (VALUES (1,'P',1,'a'),(2,'P',2,'b'),(3,'P',3,NULL),(4,'P;Q',4,'d'),(5,'P',5,'e'),(6,'P',6,'f')
) v(":ID",":LABEL","id:int","name:string")) TO '{TEST_DIR}/shortest_nodes.csv' (HEADER)

statement ok
COPY (SELECT * FROM (VALUES (1,2,'K'),(1,2,'K'),(1,3,'K'),(2,3,'K'),(3,4,'K'),(3,1,'K'),(4,5,'K')
) e(":START_ID",":END_ID",":TYPE")) TO '{TEST_DIR}/shortest_edges.csv' (HEADER)

statement ok
CREATE GRAPH shortest ANY

statement ok
COPY GRAPH shortest FROM (VERTICES '{TEST_DIR}/shortest_nodes.csv', EDGES '{TEST_DIR}/shortest_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH shortest

# No CSR has been built: the search prepares one rather than failing or enumerating.
query II rowsort
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P)
RETURN b.id, PATH_LENGTH(p)
----
1	2
2	1
3	1
4	2
5	3

foreach optimizer legacy cost

statement ok
SET gql_optimizer='{optimizer}'

# The bound limits distance, and parallel edges give one row per endpoint.
query II rowsort
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,2}(b:P)
RETURN b.id, PATH_LENGTH(p)
----
1	2
2	1
3	1
4	2

# With a minimum of 2, a vertex one hop away is reported at its shortest qualifying walk.
query II rowsort
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{2,3}(b:P)
RETURN b.id, PATH_LENGTH(p)
----
1	2
2	3
3	2
4	2
5	3

# Equal bounds keep search semantics rather than expanding into fixed hops.
query II rowsort
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{3,3}(b:P)
RETURN b.id, PATH_LENGTH(p)
----
1	3
2	3
3	3
4	3
5	3

# Unbounded search ends, and does not take the path-enumerating recursive form.
query II rowsort
MATCH p = ANY SHORTEST (a:P)-[:K]->{1,}(b:P) WHERE a.id = 1
RETURN b.id, PATH_LENGTH(p)
----
1	2
2	1
3	1
4	2
5	3

# Selecting by the far endpoint searches the other way with the same distances.
query II rowsort
MATCH p = ANY SHORTEST (a:P)-[:K]->{1,3}(b:P) WHERE b.id = 5
RETURN a.id, PATH_LENGTH(p)
----
1	3
2	3
3	2
4	1

query II rowsort
MATCH (b:P) WHERE b.id = 5
MATCH p = ANY SHORTEST (b)<-[:K]-{1,3}(a:P)
RETURN a.id, PATH_LENGTH(p)
----
1	3
2	3
3	2
4	1

# A label on the endpoint filters results but not the route through other vertices.
query II
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:Q)
RETURN b.id, PATH_LENGTH(p)
----
4	2

# Several sources are searched separately.
query III rowsort
MATCH (a:P) WHERE a.id = 2 OR a.id = 4
MATCH p = ANY SHORTEST (a)-[:K]->{1,1}(b:P)
RETURN a.id, b.id, PATH_LENGTH(p)
----
2	3	1
4	5	1

# No path gives no row; OPTIONAL gives a NULL length.
query I
MATCH (a:P) WHERE a.id = 6
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P)
RETURN PATH_LENGTH(p)
----

query II
MATCH (a:P) WHERE a.id = 6
OPTIONAL MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P)
RETURN a.id, PATH_LENGTH(p)
----
6	NULL

# Aggregates and later stages compose with it.
query II rowsort
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P)
RETURN PATH_LENGTH(p) AS hops, COUNT(*)
GROUP BY p
----
1	2
2	2
3	1

query II
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P) WHERE b.id = 4
MATCH (b)-[:K]->(c:P)
RETURN c.id, PATH_LENGTH(p)
----
5	2

# Searched CASE: first match wins, ELSE is optional, and NULL conditions do not match.
query IT rowsort
MATCH (a:P)
RETURN a.id, CASE WHEN a.id < 2 THEN 'low' WHEN a.id < 4 THEN 'mid' ELSE 'high' END
----
1	low
2	mid
3	mid
4	high
5	high
6	high

query II rowsort
MATCH (a:P) WHERE a.id < 3
RETURN a.id, CASE WHEN a.id = 1 THEN 10 END
----
1	10
2	NULL

query T
MATCH (a:P) WHERE a.id = 3
RETURN CASE WHEN a.name = 'c' THEN 'same' ELSE 'other' END
----
other

query T
MATCH (a:P) WHERE a.id = 3
RETURN CASE WHEN a.name IS NULL THEN 'missing' ELSE a.name END
----
missing

query I
MATCH (a:P)
RETURN SUM(CASE WHEN a.id > 4 THEN a.id ELSE 0 END)
----
11

# List values, nested, in a CASE, and collected.
query I
MATCH (a:P) WHERE a.id = 1
RETURN [a.id, a.id + 1]
----
[1, 2]

query I
MATCH (a:P) WHERE a.id = 1
RETURN [[a.id], [a.id + 1, 7]]
----
[[1], [2, 7]]

query I
MATCH (a:P) WHERE a.id = 1
RETURN [a.name, CAST(a.id AS STRING)]
----
[a, 1]

# CASE keeps absent OPTIONAL rows out of a collection; a plain list would keep them as NULLs.
query II rowsort
MATCH (a:P) WHERE a.id = 4 OR a.id = 5
OPTIONAL MATCH (a)-[:K]->(b:P)
RETURN a.id, COLLECT_LIST(DISTINCT CASE WHEN b.name IS NULL THEN NULL ELSE [b.name, CAST(b.id AS STRING)] END)
GROUP BY a
----
4	[[e, 5]]
5	[]

endloop

# Writes after the last CSR are found at the next search, without a manual rebuild.
statement ok
MATCH (a:P), (b:P) WHERE a.id = 1 AND b.id = 5 INSERT (a)-[:K]->(b)

query I
MATCH (a:P) WHERE a.id = 1
MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P) WHERE b.id = 5
RETURN PATH_LENGTH(p)
----
1

# Unsupported forms say so rather than returning some other answer.
statement error
MATCH p = ALL SHORTEST (a:P)-[:K]->{1,3}(b:P) RETURN PATH_LENGTH(p)
----
both endpoints

statement error
MATCH p = ANY (a:P)-[:K]->{1,3}(b:P) RETURN PATH_LENGTH(p)
----
not implemented

statement error
MATCH p = ANY SHORTEST (a:P)-[:K]->(b:P) RETURN PATH_LENGTH(p)
----
not implemented

statement error
MATCH p = ANY SHORTEST (a:P)-[:K]->{1,3}(b:P) RETURN p
----
PATH_LENGTH

statement error
MATCH p = (a:P)-[:K]->{1,3}(b:P) RETURN PATH_LENGTH(p)
----
quantified path

statement error
MATCH (a:P) RETURN CASE a.id WHEN 1 THEN 'x' END
----
not implemented

statement error
MATCH (a:P) RETURN CASE WHEN a.id = 1 THEN 'x' ELSE 2 END
----
incompatible

statement error
MATCH (a:P) RETURN CASE WHEN 1 THEN 'x' END
----
boolean

# The CSR is unavailable in an explicit transaction, which is an error and not a guess.
statement ok
BEGIN

statement error
MATCH (a:P) WHERE a.id = 1 MATCH p = ANY SHORTEST (a)-[:K]->{1,3}(b:P) RETURN PATH_LENGTH(p)
----
explicit transaction

statement ok
ROLLBACK

statement ok
DROP GRAPH shortest
