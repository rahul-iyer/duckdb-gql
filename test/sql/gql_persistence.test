# name: test/sql/gql_persistence.test
# description: Persist the canonical graph catalog across database restart
# group: [gql]

load __TEST_DIR__/gql_persistence.db

require gql

statement ok
CREATE GRAPH persistent ANY

statement ok
SESSION SET GRAPH persistent

statement ok
INSERT (:Person {name: 'Ada', age: 42})

restart

query TIII
SELECT graph_name, graph_version, vertex_count, edge_count
FROM gql_graphs()
----
persistent	1	1	0

query TT
SELECT property_name, union_tag(value)
FROM gql_properties()
ORDER BY property_name
----
age	int_value
name	string_value

query T
SELECT union_extract(value, 'string_value')
FROM gql_properties() WHERE property_name = 'name'
----
Ada

statement ok
SESSION SET GRAPH persistent

statement ok
MATCH (person:Person) WHERE person.name = 'Ada'
SET person.city = 'London'

statement ok
MATCH (person:Person) WHERE person.name = 'Ada'
REMOVE person.age

restart

query TT rowsort
SELECT property_name, union_tag(value)
FROM gql_properties()
ORDER BY property_name
----
city	string_value
name	string_value

query T
SELECT union_extract(value, 'string_value')
FROM gql_properties() WHERE property_name = 'city'
----
London

statement ok
DROP GRAPH persistent
