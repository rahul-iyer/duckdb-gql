# name: test/sql/gql_native_insert.test
# description: ISO GQL INSERT over managed native graph tables
# group: [gql]

require gql

statement ok
COPY (
    SELECT * FROM (VALUES
        ('p1', 'Ada', 42, 'Person;Engineer'),
        ('p2', 'Grace', 37, 'Person')
    ) nodes("external_id:ID(People)", "name:string", "age:int", ":LABEL")
) TO '__TEST_DIR__/gql_native_insert_nodes.csv' (FORMAT CSV, HEADER)

statement ok
COPY (
    SELECT * FROM (VALUES
        ('p1', 'p2', 'KNOWS', 2020)
    ) relationships(":START_ID(People)", ":END_ID(People)", ":TYPE", "since:int")
) TO '__TEST_DIR__/gql_native_insert_edges.csv' (FORMAT CSV, HEADER)

statement ok
CREATE GRAPH native_insert ANY

statement ok
COPY GRAPH native_insert FROM (
    VERTICES '__TEST_DIR__/gql_native_insert_nodes.csv',
    EDGES '__TEST_DIR__/gql_native_insert_edges.csv'
) FORMAT NEO4J

statement error
INSERT (:Person {external_id: 'not-selected', name: 'Nobody', age: 0})
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before mutation.*

statement ok
SESSION SET GRAPH native_insert

# A single node gets a sequence-backed native key, labels, and typed properties.
statement ok
INSERT (person:Person&Engineer {external_id: 'p3', name: 'Linus', age: 31})

query ITT
MATCH (person:Person&Engineer) WHERE person.external_id = 'p3'
RETURN person.age, person.name, person.external_id
----
31	Linus	p3

# A directed path creates both endpoint nodes and the edge as one command.
statement ok
INSERT (source:Person {external_id: 'p4', name: 'Margaret', age: 35})
       -[relationship:KNOWS {since: 2024}]->
       (target:Person {external_id: 'p5', name: 'Barbara', age: 29})

query TTI
MATCH (source:Person)-[relationship:KNOWS]->(target:Person)
WHERE source.external_id = 'p4' AND target.external_id = 'p5'
RETURN source.name, target.name, relationship.since
----
Margaret	Barbara	2024

# Left-pointing syntax stores the endpoints in the arrow direction.
statement ok
INSERT (target:Person {external_id: 'p6', name: 'Edsger', age: 40})
       <-[relationship:KNOWS {since: 2025}]-
       (source:Person {external_id: 'p7', name: 'Donald', age: 41})

query TT
MATCH (source:Person)-[:KNOWS]->(target:Person)
WHERE source.external_id = 'p7' AND target.external_id = 'p6'
RETURN source.name, target.name
----
Donald	Edsger

# Every element in a longer fixed path uses the same preallocated id row.
statement ok
INSERT (:Person {external_id: 'p8', name: 'A', age: 1})
       -[:KNOWS {since: 2021}]->
       (:Person {external_id: 'p9', name: 'B', age: 2})
       -[:KNOWS {since: 2022}]->
       (:Person {external_id: 'p10', name: 'C', age: 3})

query I
MATCH (a:Person)-[:KNOWS]->(b:Person)-[:KNOWS]->(c:Person)
WHERE a.external_id = 'p8' AND c.external_id = 'p10'
RETURN count(*)
----
1

# A later conversion failure rolls back vertices already written by the same
# autocommit command.
statement error
INSERT (:Person {external_id: 'atomic-a', name: 'First', age: 1})
       -[:KNOWS {since: 2030}]->
       (:Person {external_id: 'atomic-b', name: 'Second', age: 'bad'})
----
<REGEX>:.*Could not convert string.*

query I
MATCH (person:Person)
WHERE person.external_id = 'atomic-a' OR person.external_id = 'atomic-b'
RETURN count(*)
----
0

# MATCH-bound nodes are reused as endpoints. New nodes and edges are created
# once per matched row, and property expressions are evaluated from that row.
statement ok
MATCH (source:Person) WHERE source.external_id = 'p1'
INSERT (source)-[:KNOWS {since: 2031}]->
       (:Person {external_id: source.external_id || '-copy',
                 name: upper(source.name), age: source.age + 1})

query TTI
MATCH (source:Person)-[relationship:KNOWS]->(target:Person)
WHERE source.external_id = 'p1' AND target.external_id = 'p1-copy'
RETURN target.name, target.external_id, relationship.since
----
ADA	p1-copy	2031

# A left-pointing pipeline can connect two existing matched nodes without
# reinserting either endpoint.
statement ok
MATCH (left_node:Person), (right_node:Person)
WHERE left_node.external_id = 'p2' AND right_node.external_id = 'p1'
INSERT (left_node)<-[:KNOWS {since: 2032}]-(right_node)

query I
MATCH (source:Person)-[relationship:KNOWS]->(target:Person)
WHERE source.external_id = 'p1' AND target.external_id = 'p2'
      AND relationship.since = 2032
RETURN count(*)
----
1

# Reusing one matched node at both endpoints creates a self-loop, not a second
# copy of the node.
statement ok
MATCH (root:Person) WHERE root.external_id = 'p3'
INSERT (root)-[:KNOWS {since: 2033}]->(root)

query I
MATCH (root:Person)-[relationship:KNOWS]->(root)
WHERE root.external_id = 'p3' AND relationship.since = 2033
RETURN count(*)
----
1

# Match cardinality controls insertion cardinality.
statement ok
MATCH (source:Person)
WHERE source.external_id = 'p1' OR source.external_id = 'p2'
INSERT (source)-[:KNOWS {since: 2040}]->
       (:Person {external_id: source.external_id || '-child',
                 name: source.name, age: source.age})

query I
MATCH (child:Person)
WHERE child.external_id = 'p1-child' OR child.external_id = 'p2-child'
RETURN count(*)
----
2

# A newly declared variable is allocated once per match row when reused within
# the INSERT path.
statement ok
MATCH (source:Person) WHERE source.external_id = 'p2'
INSERT (loop:Person {external_id: 'new-loop', name: source.name, age: 1})
       -[:KNOWS {since: 2042}]->(loop)

query I
MATCH (loop:Person)-[relationship:KNOWS]->(loop)
WHERE loop.external_id = 'new-loop' AND relationship.since = 2042
RETURN count(*)
----
1

# No matching rows produce no graph writes.
statement ok
MATCH (source:Person) WHERE source.external_id = 'does-not-exist'
INSERT (source)-[:KNOWS {since: 2041}]->
       (:Person {external_id: 'should-not-exist', name: 'Nobody', age: 0})

query I
MATCH (person:Person) WHERE person.external_id = 'should-not-exist'
RETURN count(*)
----
0

# A later edge conversion failure rolls back all nodes created from the match
# snapshot, including rows inserted by an earlier generated statement.
statement error
MATCH (source:Person)
WHERE source.external_id = 'p1' OR source.external_id = 'p2'
INSERT (source)-[:KNOWS {since: source.name}]->
       (:Person {external_id: source.external_id || '-atomic-child',
                 name: source.name, age: 1})
----
<REGEX>:.*Could not convert string.*

query I
MATCH (person:Person)
WHERE person.external_id = 'p1-atomic-child'
   OR person.external_id = 'p2-atomic-child'
RETURN count(*)
----
0

statement error
MATCH (source:Person) WHERE source.external_id = 'p1'
INSERT (source)
----
<REGEX>:.*node variable 'source' is already bound.*

statement error
MATCH (source:Person) WHERE source.external_id = 'p1'
INSERT (source:Other)-[:KNOWS]->(:Person)
----
<REGEX>:.*node variable 'source' is already bound.*

statement error
MATCH (:Person)-[relationship:KNOWS]->(:Person)
INSERT ()-[relationship:KNOWS]->()
----
<REGEX>:.*edge variable 'relationship' is already bound.*

# INSERT participates in an explicit caller transaction and supports
# read-your-writes without owning the transaction boundary.
statement ok
BEGIN TRANSACTION

statement ok
INSERT (:Person {external_id: 'rollback', name: 'Transient', age: 1})

query I
MATCH (person:Person) WHERE person.external_id = 'rollback'
RETURN count(*)
----
1

statement ok
ROLLBACK

query I
MATCH (person:Person) WHERE person.external_id = 'rollback'
RETURN count(*)
----
0

statement ok
BEGIN TRANSACTION

statement ok
MATCH (source:Person) WHERE source.external_id = 'p1'
INSERT (source)-[:KNOWS {since: 2050}]->
       (:Person {external_id: 'pipeline-rollback', name: 'Transient', age: 1})

query I
MATCH (person:Person) WHERE person.external_id = 'pipeline-rollback'
RETURN count(*)
----
1

statement ok
ROLLBACK

query I
MATCH (person:Person) WHERE person.external_id = 'pipeline-rollback'
RETURN count(*)
----
0

statement ok
BEGIN TRANSACTION

statement ok
INSERT (:Person {external_id: 'committed', name: 'Persistent', age: 2})

statement ok
COMMIT

query I
MATCH (person:Person) WHERE person.external_id = 'committed'
RETURN count(*)
----
1

statement error
INSERT (:Person {external_id: 'unknown', missing_property: 1})
----
<REGEX>:.*Property 'missing_property' is not mapped.*

statement error
INSERT (:Person {external_id: 'duplicate', age: 1, age: 2})
----
<REGEX>:.*Duplicate GQL INSERT property 'age'.*

statement error
INSERT (:Person)~[:KNOWS]~(:Person)
----
<REGEX>:.*undirected edge INSERT patterns.*
