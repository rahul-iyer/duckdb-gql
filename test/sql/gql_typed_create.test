# name: test/sql/gql_typed_create.test
# description: Materialize, persist, mutate, and remove explicit inline typed graph schemas
# group: [gql]

load __TEST_DIR__/gql_typed_create.db

require duckgql

query IT
CREATE GRAPH persistent_typed TYPED {
    (Person :Person {id INT64 NOT NULL, name STRING}),
    (Person)-[:KNOWS {since INT32}]->(Person)
}
----
true	persistent_typed

restart

query TIT
SELECT s.schema_kind, s.is_typed, st.storage_mode
FROM gql_internal.graphs g
JOIN gql_internal.graph_schemas s USING (graph_id)
JOIN gql_internal.graph_storage st USING (graph_id)
WHERE g.graph_name = 'persistent_typed'
----
INLINE	true	TABLE_BACKED

query ITT
SELECT e.element_ordinal, e.element_kind, e.type_name
FROM gql_internal.graph_schema_elements e
JOIN gql_internal.graphs g USING (graph_id)
WHERE g.graph_name = 'persistent_typed'
ORDER BY e.element_ordinal
----
0	NODE	person
1	EDGE	knows

query TTIT
SELECT e.type_name, p.property_name, p.nullable, p.gql_type
FROM gql_internal.graph_schema_elements e
JOIN gql_internal.graph_schema_properties p USING (schema_element_id)
JOIN gql_internal.graphs g USING (graph_id)
WHERE g.graph_name = 'persistent_typed'
ORDER BY e.element_ordinal, p.property_ordinal
----
person	id	false	INT64
person	name	true	STRING
knows	since	true	INT32

query TTI
SELECT et.element_kind, pm.property_name, pm.gql_type
FROM gql_internal.graphs g
JOIN gql_internal.graph_element_tables et USING (graph_id)
JOIN gql_internal.graph_property_mappings pm USING (element_table_id)
WHERE g.graph_name = 'persistent_typed'
ORDER BY et.element_kind DESC, pm.property_name
----
VERTEX	id	BIGINT
VERTEX	name	VARCHAR
EDGE	since	INTEGER

statement ok
SESSION SET GRAPH persistent_typed

statement ok
INSERT (alice:Person {id: 1, name: 'Alice'})
       -[:KNOWS {since: 2020}]->
       (bob:Person {id: 2, name: 'Bob'})

query TTI
MATCH (source:Person)-[relationship:KNOWS]->(target:Person)
RETURN source.name, target.name, relationship.since
----
Alice	Bob	2020

# INSERT RETURN exposes newly created variables as the same node structs used
# by MATCH. Result columns follow RETURN order, including for comma-separated
# node paths and for a node whose generated ID precedes the current sequence.
query T
INSERT (carol:Person {id: 3, name: 'Carol'})
RETURN carol
----
{'vertex_id': 3, '__gql_labels': person, 'id': 3, 'name': Carol}

query T
INSERT (dave:Person {id: 4, name: 'Dave'})
       -[:KNOWS {since: 2021}]->
       (eve:Person {id: 5, name: 'Eve'})
RETURN dave AS created
----
{'vertex_id': 4, '__gql_labels': person, 'id': 4, 'name': Dave}

query TT
INSERT (frances:Person {id: 6, name: 'Frances'}),
       (george:Person {id: 7, name: 'George'})
RETURN george AS `Second Node`, frances AS "First Node"
----
{'vertex_id': 7, '__gql_labels': person, 'id': 7, 'name': George}	{'vertex_id': 6, '__gql_labels': person, 'id': 6, 'name': Frances}

query TTT
INSERT (henrietta:Person {id: 8, name: 'Henrietta'}),
       (ida:Person {id: 9, name: 'Ida'}),
       (jean:Person {id: 10, name: 'Jean'})
RETURN henrietta, ida, jean
----
{'vertex_id': 8, '__gql_labels': person, 'id': 8, 'name': Henrietta}	{'vertex_id': 9, '__gql_labels': person, 'id': 9, 'name': Ida}	{'vertex_id': 10, '__gql_labels': person, 'id': 10, 'name': Jean}

query TT
INSERT (katherine:Person {id: 11, name: 'Katherine'})
       -[:KNOWS {since: 2022}]->
       (lois:Person {id: 12, name: 'Lois'})
RETURN lois, katherine
----
{'vertex_id': 12, '__gql_labels': person, 'id': 12, 'name': Lois}	{'vertex_id': 11, '__gql_labels': person, 'id': 11, 'name': Katherine}

query TT
INSERT (repeated:Person {id: 13, name: 'Repeated'})
RETURN repeated AS first_copy, repeated AS second_copy
----
{'vertex_id': 13, '__gql_labels': person, 'id': 13, 'name': Repeated}	{'vertex_id': 13, '__gql_labels': person, 'id': 13, 'name': Repeated}

# Returning multiple nodes does not take ownership of a caller-controlled
# transaction.
statement ok
BEGIN TRANSACTION

query TT
INSERT (temporary:Person {id: 14, name: 'Temporary'}),
       (temporary_two:Person {id: 15, name: 'Temporary Two'})
RETURN temporary, temporary_two
----
{'vertex_id': 14, '__gql_labels': person, 'id': 14, 'name': Temporary}	{'vertex_id': 15, '__gql_labels': person, 'id': 15, 'name': Temporary Two}

statement ok
ROLLBACK

query I
MATCH (person:Person) WHERE person.id = 14 OR person.id = 15
RETURN count(*)
----
0

# Invalid or anonymous result references fail before any graph write.
statement error
INSERT (known:Person {id: 16, name: 'Known'})
RETURN missing
----
<REGEX>:.*GQL INSERT RETURN variable 'missing' is not a directly inserted node.*

statement error
INSERT (:Person {id: 16, name: 'Anonymous'})
RETURN unnamed
----
<REGEX>:.*GQL INSERT RETURN variable 'unnamed' is not a directly inserted node.*

query I
MATCH (person:Person) WHERE person.id = 16
RETURN count(*)
----
0

# The native columns enforce scalar types, while generated CHECK constraints
# enforce the selected node/edge type and its per-type nullability.
statement error
INSERT (:Person {name: 'Missing id'})
----
<REGEX>:.*CHECK constraint failed.*

statement error
INSERT (:Other {id: 30, name: 'Unknown type'})
----
<REGEX>:.*CHECK constraint failed.*

statement error
INSERT (:Person {id: 40, name: 'Bad edge'})-[:KNOWS {since: 'not-an-integer'}]->(:Person {id: 41})
----
<REGEX>:.*Could not convert string.*

query I
MATCH (person:Person) WHERE person.id = 40 OR person.id = 41
RETURN count(*)
----
0

statement ok
DROP GRAPH persistent_typed

restart

query I
SELECT count(*) FROM gql_internal.graphs WHERE graph_name = 'persistent_typed'
----
0

query I
SELECT count(*)
FROM gql_internal.graph_schemas s
LEFT JOIN gql_internal.graphs g USING (graph_id)
WHERE g.graph_id IS NULL
----
0

query I
SELECT count(*)
FROM gql_internal.graph_schema_elements e
LEFT JOIN gql_internal.graphs g USING (graph_id)
WHERE g.graph_id IS NULL
----
0

query I
SELECT count(*) FROM duckdb_tables()
WHERE schema_name = 'gql_data' AND table_name LIKE 'graph_%'
----
0

# INSERT RETURN projects newly inserted edges with the same identity, type,
# endpoints, and properties exposed by MATCH.
statement ok
CREATE GRAPH insert_return_edges TYPED {
    (Node :Node {id INT64 NOT NULL, name STRING}),
    (Node)-[:LINK {weight INT32}]->(Node)
}

statement ok
SESSION SET GRAPH insert_return_edges

query T
INSERT (source:Node {id: 1, name: 'Source'})
       -[created_edge:LINK {weight: 10}]->
       (target:Node {id: 2, name: 'Target'})
RETURN created_edge
----
{'edge_id': 1, '__gql_type': link, '__gql_source': 1, '__gql_target': 2, 'weight': 10}

# Node and edge projections share one ordered result, including an edge alias.
query TTT
INSERT (mixed_source:Node {id: 3, name: 'Mixed source'})
       -[mixed_edge:LINK {weight: 20}]->
       (mixed_target:Node {id: 4, name: 'Mixed target'})
RETURN mixed_target, mixed_edge AS relationship, mixed_source
----
{'vertex_id': 4, '__gql_labels': node, 'id': 4, 'name': Mixed target}	{'edge_id': 2, '__gql_type': link, '__gql_source': 3, '__gql_target': 4, 'weight': 20}	{'vertex_id': 3, '__gql_labels': node, 'id': 3, 'name': Mixed source}

# Edge indices remain correct across independent paths and mixed projection
# order.
query TTTT
INSERT (a:Node {id: 5, name: 'A'})-[e1:LINK {weight: 30}]->(b:Node {id: 6, name: 'B'}),
       (c:Node {id: 7, name: 'C'})-[e2:LINK {weight: 31}]->(d:Node {id: 8, name: 'D'})
RETURN e1, d, e2, a
----
{'edge_id': 3, '__gql_type': link, '__gql_source': 5, '__gql_target': 6, 'weight': 30}	{'vertex_id': 8, '__gql_labels': node, 'id': 8, 'name': D}	{'edge_id': 4, '__gql_type': link, '__gql_source': 7, '__gql_target': 8, 'weight': 31}	{'vertex_id': 5, '__gql_labels': node, 'id': 5, 'name': A}

query TT
INSERT (repeat_source:Node {id: 9, name: 'Repeat source'})
       -[repeated_edge:LINK {weight: 50}]->
       (repeat_target:Node {id: 10, name: 'Repeat target'})
RETURN repeated_edge AS first_copy, repeated_edge AS second_copy
----
{'edge_id': 5, '__gql_type': link, '__gql_source': 9, '__gql_target': 10, 'weight': 50}	{'edge_id': 5, '__gql_type': link, '__gql_source': 9, '__gql_target': 10, 'weight': 50}

# Invalid projections fail before any part of the INSERT is written.
statement error
INSERT (known_source:Node {id: 11, name: 'Known source'})
       -[known_edge:LINK {weight: 55}]->
       (known_target:Node {id: 12, name: 'Known target'})
RETURN missing
----
<REGEX>:.*GQL INSERT RETURN variable 'missing' is not a directly inserted node.*

query I
MATCH (node:Node) WHERE node.id = 11 OR node.id = 12
RETURN count(*)
----
0

# Returning an edge keeps the complete mutation under the caller's transaction.
statement ok
BEGIN TRANSACTION

query T
INSERT (rollback_source:Node {id: 11, name: 'Rollback source'})
       -[rollback_edge:LINK {weight: 60}]->
       (rollback_target:Node {id: 12, name: 'Rollback target'})
RETURN rollback_edge
----
{'edge_id': 6, '__gql_type': link, '__gql_source': 11, '__gql_target': 12, 'weight': 60}

statement ok
ROLLBACK

query I
MATCH (:Node)-[relationship:LINK]->(:Node) WHERE relationship.weight = 60
RETURN count(*)
----
0

statement ok
DROP GRAPH insert_return_edges
