# name: test/sql/gql_insert.test
# description: GQL vertex insertion into normalized, typed property storage
# group: [gql]

require gql

statement error
INSERT (:Person {name: 'orphan'})
----
No graph selected; use SESSION SET GRAPH before INSERT

statement ok
CREATE GRAPH social ANY

statement ok
SESSION SET GRAPH social

query ITI
INSERT (:Person&Researcher {
    name: 'Ada', age: 42, score: 9.5, active: TRUE,
    estimate: 1e2, delta: -7, quote: 'Ada''s'
})
----
true	social	1

query TITT
SELECT graph_name, object_id, labels::VARCHAR, array_length(labels)::VARCHAR
FROM gql_vertices()
----
social	1	[person, researcher]	2

query TT
SELECT property_name, union_tag(value)
FROM gql_properties()
ORDER BY property_name
----
active	bool_value
age	int_value
delta	int_value
estimate	double_value
name	string_value
quote	string_value
score	decimal_value

query I
SELECT union_extract(value, 'bool_value')
FROM gql_properties() WHERE property_name = 'active'
----
true

query I
SELECT union_extract(value, 'int_value')
FROM gql_properties() WHERE property_name = 'age'
----
42

query T
SELECT union_extract(value, 'string_value')
FROM gql_properties() WHERE property_name = 'name'
----
Ada

query R
SELECT union_extract(value, 'decimal_value')
FROM gql_properties() WHERE property_name = 'score'
----
9.5

query I
SELECT union_extract(value, 'double_value') = 100.0
FROM gql_properties() WHERE property_name = 'estimate'
----
true

query I
SELECT union_extract(value, 'int_value')
FROM gql_properties() WHERE property_name = 'delta'
----
-7

query T
SELECT union_extract(value, 'string_value')
FROM gql_properties() WHERE property_name = 'quote'
----
Ada's

query TIII
SELECT graph_name, graph_version, vertex_count, edge_count
FROM gql_graphs()
----
social	1	1	0

# A second object reuses label and property-key dictionary rows.
statement ok
INSERT (:Person {name: "Grace", age: 37})

query II
SELECT (SELECT count(*) FROM gql_internal.labels),
       (SELECT count(*) FROM gql_internal.property_keys)
----
2	7

query II
SELECT graph_version, vertex_count FROM gql_graphs()
----
2	2

# Duplicate properties violate the normalized object/key primary key. The whole
# insert, including the object and version change, must roll back.
statement error
INSERT (:Person {name: 'bad', name: 'duplicate'})
----
<REGEX>:.*GQL internal storage error.*

query II
SELECT graph_version, vertex_count FROM gql_graphs()
----
2	2

statement error
INSERT (:Person {computed: 1 + 2})
----
<REGEX>:.*GQL feature not implemented: non-scalar literal property values in INSERT.*

statement error
INSERT (:Person)~[:KNOWS]~(:Person)
----
<REGEX>:.*GQL feature not implemented: undirected edge INSERT patterns.*

statement ok
DROP GRAPH social

query IIIII
SELECT (SELECT count(*) FROM gql_internal.objects),
       (SELECT count(*) FROM gql_internal.labels),
       (SELECT count(*) FROM gql_internal.object_labels),
       (SELECT count(*) FROM gql_internal.property_keys),
       (SELECT count(*) FROM gql_internal.object_properties)
----
0	0	0	0	0
