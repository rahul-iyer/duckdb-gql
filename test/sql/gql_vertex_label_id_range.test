# name: test/sql/gql_vertex_label_id_range.test
# description: A label's vertex ID range narrows its table scans only while the CSR lists every vertex
# group: [gql]

require duckgql

# Each label's vertices are loaded together: Person 1-3, City 4-6.
statement ok
COPY (SELECT * FROM (VALUES (1,'Person',10),(2,'Person',20),(3,'Person',30),(4,'City',40),(5,'City',50),(6,'City',60))
      v(":ID",":LABEL","score:int")) TO '{TEST_DIR}/range_nodes.csv' (HEADER)

statement ok
COPY (SELECT * FROM (VALUES (1,4,'LIVES_IN'),(2,5,'LIVES_IN'),(3,5,'LIVES_IN'))
      e(":START_ID",":END_ID",":TYPE")) TO '{TEST_DIR}/range_edges.csv' (HEADER)

statement ok
CREATE GRAPH ranges ANY

statement ok
COPY GRAPH ranges FROM (VERTICES '{TEST_DIR}/range_nodes.csv', EDGES '{TEST_DIR}/range_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH ranges

statement ok
CALL gql_build_csr('ranges')

query I
MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
200

query II
EXPLAIN MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
physical_plan	<REGEX>:.*__gql_id <= 3.*

# An inserted Person can have any ID, so the range no longer covers the label: results include it.
statement ok
INSERT (:Person {score: 70})

statement ok
MATCH (p:Person), (c:City) WHERE p.score = 70 AND c.score = 60 INSERT (p)-[:LIVES_IN]->(c)

query I
MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
330

query II
EXPLAIN MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
physical_plan	<!REGEX>:.*__gql_id <= 3.*

# A rebuild lists the new vertex, and the range covers it again.
statement ok
CALL gql_build_csr('ranges')

query I
MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
330

statement ok
SET gql_optimizer='cost'

query I
MATCH (p:Person)-[:LIVES_IN]->(c:City) RETURN sum(p.score + c.score)
----
330

statement ok
DROP GRAPH ranges
