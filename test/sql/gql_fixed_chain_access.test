# name: test/sql/gql_fixed_chain_access.test
# description: Fixed-chain CSR access preserves parallel edges, trail identity and optional boundaries
# group: [gql]

require duckgql

statement ok
SET threads=1

statement ok
COPY (SELECT i AS ":ID", i AS "id:int", 'Node' AS ":LABEL" FROM range(1,5) t(i)) TO '{TEST_DIR}/chain_nodes.csv' (HEADER)

statement ok
COPY (SELECT 1 AS ":START_ID", 2 AS ":END_ID", 'R' AS ":TYPE"
 UNION ALL SELECT 1,2,'R' UNION ALL SELECT 2,3,'R'
 UNION ALL SELECT 3,1,'R' UNION ALL SELECT 3,4,'S')
TO '{TEST_DIR}/chain_edges.csv' (HEADER)

statement ok
CREATE GRAPH chain_access ANY

statement ok
COPY GRAPH chain_access FROM (VERTICES '{TEST_DIR}/chain_nodes.csv', EDGES '{TEST_DIR}/chain_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH chain_access

statement ok
CALL gql_create_property_index('chain_access', 'id')

statement ok
CALL gql_build_csr('chain_access')

# An independent singleton seeds a chain in the same MATCH region. Two
# parallel edges must remain two rows after each selected CSR expansion.
query I rowsort
MATCH (a:Node), (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:S]->(d:Node)
WHERE a.id=1 RETURN d.id
----
4
4

query I
SELECT count(*) FROM gql_optimizer_plan() WHERE access_path='CSR_EXPANSION'
----
3

query I rowsort
MATCH (a:Node), (d:Node)<-[:S]-(c:Node)<-[:R]-(b:Node)<-[:R]-(a)
WHERE a.id=1 RETURN d.id
----
4
4

# A four-edge trail can use the OTHER parallel edge on the second visit.
query I
MATCH (a:Node), (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:R]->(d:Node)-[:R]->(e:Node)
WHERE a.id=1 RETURN count(*)
----
2

# A fifth R edge would reuse the unique 2->3 edge, which is forbidden in
# this fixed path even though each physical expansion sees that edge.
query I
MATCH (a:Node), (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:R]->(d:Node)-[:R]->(e:Node)-[:R]->(f:Node)
WHERE a.id=1 RETURN count(*)
----
0

# Optional predicate failure must preserve the outer row with null bindings.
query II
MATCH (a:Node) WHERE a.id=4
OPTIONAL MATCH (a)-[:R]->(b:Node)-[:R]->(c:Node)
RETURN a.id, c.id
----
4	NULL

# Separate fixed MATCH paths have their own TRAIL scope and can reuse an edge.
query I
MATCH (a:Node) WHERE a.id=1
MATCH (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:R]->(d:Node)
MATCH (d)-[:R]->(e:Node)-[:R]->(f:Node)
RETURN count(*)
----
4

# Correlated fixed chains retain parallel-edge multiplicity. The access plan
# may split the chain, but the optional boundary still encloses the whole path.
query II rowsort
MATCH (a:Node) WHERE a.id=1
OPTIONAL MATCH (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:S]->(d:Node)
RETURN a.id,d.id
----
1	4
1	4

query I
SELECT count(*) > 0 FROM gql_optimizer_plan() WHERE stage_id=1 AND access_path='CSR_EXPANSION'
----
true

# Both endpoints are captured from the left. A failing ON predicate must
# null-extend once, rather than retain partial matches or drop the outer row.
query III rowsort
MATCH (a:Node),(d:Node) WHERE a.id=1 AND (d.id=3 OR d.id=4)
OPTIONAL MATCH (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:S]->(d)
RETURN a.id,d.id,c.id
----
1	3	NULL
1	4	3
1	4	3

# TRAIL applies across the complete correlated path, including the suffix.
query I
MATCH (a:Node) WHERE a.id=1
OPTIONAL MATCH (a)-[:R]->(b:Node)-[:R]->(c:Node)-[:R]->(d:Node)-[:R]->(e:Node)-[:R]->(f:Node)
RETURN count(f.id)
----
0
