# The combination budget is independent of the label-group budget.
statement ok
COPY (SELECT 's'||i::VARCHAR AS ":ID", 'S'||i::VARCHAR AS ":LABEL" FROM range(65) r(i)
 UNION ALL SELECT 't'||i::VARCHAR, 'T'||i::VARCHAR FROM range(65) r(i))
TO '{TEST_DIR}/endpoint_combination_nodes.csv' (HEADER)

statement ok
