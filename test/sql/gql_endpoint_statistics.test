# name: test/sql/gql_endpoint_statistics.test
# description: Bounded snapshot-owned joint endpoint label-set statistics
# group: [gql]

require duckgql

statement ok
SET threads=1

statement ok
COPY (SELECT * FROM (VALUES
 ('p1','Person;Sender',1),('p2','Sender;Person',2),('p3','Person;Sender',3),
 ('city','City;Place',4),('post','Message;Post',5),('comment','Message;Comment',6),
 ('country','Country;Place',7),('plain','',8)) v(":ID",":LABEL","score:int"))
TO '{TEST_DIR}/endpoint_nodes.csv' (HEADER)

statement ok
COPY (SELECT * FROM (VALUES ('p1','city','R'),('p1','city','R'),('p2','city','R'),
 ('post','country','R'),('comment','country','R'),('p1','p1','R'),('plain','city','R'))
 e(":START_ID",":END_ID",":TYPE")) TO '{TEST_DIR}/endpoint_edges.csv' (HEADER)

statement ok
CREATE GRAPH endpoints ANY

statement ok
COPY GRAPH endpoints FROM (VERTICES '{TEST_DIR}/endpoint_nodes.csv', EDGES '{TEST_DIR}/endpoint_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH endpoints

statement ok
CALL gql_build_csr('endpoints')

query T
SELECT endpoint_statistics_status FROM gql_csr_stats('endpoints')
----
not_requested

statement error
SELECT * FROM gql_csr_endpoint_stats('endpoints')
----
Endpoint statistics unavailable (not_requested)

statement error
CALL gql_build_csr('endpoints', endpoint_statistics := NULL)
----
must be a non-NULL BOOLEAN

statement ok
CALL gql_build_csr('endpoints', endpoint_statistics := true)

query TIII
SELECT endpoint_statistics_status, endpoint_label_groups, endpoint_combinations,
 endpoint_statistics_bytes > 0 FROM gql_csr_stats('endpoints')
----
complete	6	5	true

query I
SELECT (capability_mask & 256)<>0 FROM gql_csr_stats('endpoints')
----
true

# Different orderings of the same label set form one partition. Parallel edges
# count separately; active endpoints count each participating vertex once.
query IIIII
SELECT edge_count, source_active_vertices, target_active_vertices, source_population, target_population
FROM gql_csr_endpoint_stats('endpoints')
WHERE list_contains(source_labels,'person') AND list_contains(target_labels,'city')
----
3	2	1	3	1

# Complete label sets partition the graph: overlapping labels do not duplicate
# edges in these totals. Each row's distinct counts are local to that pair.
query II
SELECT sum(edge_count), count(*) FROM gql_csr_endpoint_stats('endpoints')
----
7	5

query II
SELECT sum(edge_count), count(*) FROM gql_csr_endpoint_stats('endpoints')
WHERE list_contains(source_labels,'message') AND list_contains(target_labels,'country')
----
2	2

query III
SELECT edge_count,source_active_vertices,target_active_vertices FROM gql_csr_endpoint_stats('endpoints')
WHERE list_contains(source_labels,'person') AND list_contains(target_labels,'person')
----
1	1	1

query II
SELECT edge_count,source_population FROM gql_csr_endpoint_stats('endpoints') WHERE len(source_labels)=0
----
1	1

# The old marginal labels both occur on R, but this particular endpoint
# combination does not. A complete joint distribution can distinguish it.
query I
SELECT count(*) FROM gql_csr_endpoint_stats('endpoints')
WHERE list_contains(source_labels,'person') AND list_contains(target_labels,'country')
----
0

statement ok
SET gql_optimizer='cost'

query I
MATCH (s:Person)-[:R]->(t:City) RETURN count(*)
----
3

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='r'
----
3	3

query I
MATCH (t:City)<-[:R]-(s:Person) RETURN count(*)
----
3

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='r'
----
3	3

# A source that reaches two target groups is active once in the marginal,
# not once per group. The point predicate therefore has a 3/2 fanout estimate.
query I
MATCH (s:Person)-[:R]->(t:City) WHERE s.score=1 RETURN count(*)
----
2

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='r'
----
3	2

query I
MATCH (s:Person)-[:R]->(t:Country) RETURN count(*)
----
0

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='r'
----
0	0

# An unnamed edge matches every type; it is not an absent named type.
# Keep the existing wildcard estimator until an all-type joint model is used.
query I
MATCH (s)-[e]->(t) RETURN count(*)
----
7

query I
SELECT endpoint_edges IS NULL AND estimated_rows=7 FROM gql_optimizer_plan() WHERE binding_id=1
----
true

query I
MATCH (s:Person)-[:UNSEEN]->(t:City) RETURN count(*)
----
0

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='unseen'
----
0	0

query I
MATCH (s:Person&Sender)-[:R]->(t:City&Place) RETURN count(*)
----
3

query II
SELECT endpoint_edges,estimated_rows FROM gql_optimizer_plan() WHERE edge_label='r'
----
3	3

