# More than 256 different label sets discards the optional distribution.
statement ok
COPY (SELECT i::VARCHAR AS ":ID", 'L'||i::VARCHAR AS ":LABEL" FROM range(257) r(i))
TO '{TEST_DIR}/endpoint_group_nodes.csv' (HEADER)

statement ok
COPY (SELECT i::VARCHAR AS ":START_ID", i::VARCHAR AS ":END_ID", 'R' AS ":TYPE" FROM range(257) r(i))
TO '{TEST_DIR}/endpoint_group_edges.csv' (HEADER)

