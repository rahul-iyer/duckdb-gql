query I
SELECT bool_and(source_catalog IS NULL AND source_snapshot_id IS NULL AND
 graph_version=(SELECT graph_version FROM gql_csr_stats('endpoints')))
FROM gql_csr_endpoint_stats('endpoints')
----
true

# Native SQL can change data without incrementing the graph catalog version.
# Table write generations must still invalidate the joint distribution.
statement ok
SET VARIABLE prior_endpoint_version=(SELECT max(graph_version) FROM gql_csr_endpoint_stats('endpoints'))

statement ok
DELETE FROM gql_data.graph_1_edges
WHERE __gql_source_id=(SELECT __gql_id FROM gql_data.graph_1_vertices WHERE score=1)
  AND __gql_target_id=(SELECT __gql_id FROM gql_data.graph_1_vertices WHERE score=7)

