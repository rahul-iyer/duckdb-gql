# Compare every populated combination against independent relational joins and
# aggregates on a larger graph with overlapping labels and repeated edges.
statement ok
COPY (SELECT i::VARCHAR AS ":ID",
 (CASE i%4 WHEN 0 THEN 'Shared;A' WHEN 1 THEN 'B;Shared' WHEN 2 THEN 'C' ELSE '' END)
 || CASE WHEN i%11=0 THEN ';Extra' ELSE '' END AS ":LABEL"
 FROM range(1000) r(i)) TO '{TEST_DIR}/endpoint_reference_nodes.csv' (HEADER)

statement ok
COPY (SELECT ((i*17+3)%997)::VARCHAR AS ":START_ID", ((i*i*13+19)%997)::VARCHAR AS ":END_ID",
 CASE i%3 WHEN 0 THEN 'R' WHEN 1 THEN 'S' ELSE 'T' END AS ":TYPE" FROM range(3000) r(i)
 UNION ALL SELECT '3','19','R' UNION ALL SELECT '3','19','R')
TO '{TEST_DIR}/endpoint_reference_edges.csv' (HEADER)

statement ok
CREATE GRAPH endpoint_reference ANY

statement ok
COPY GRAPH endpoint_reference FROM (VERTICES '{TEST_DIR}/endpoint_reference_nodes.csv', EDGES '{TEST_DIR}/endpoint_reference_edges.csv') FORMAT GRAPH

statement ok
SET VARIABLE endpoint_reference_vertices=(SELECT et.schema_name||'.'||et.table_name
 FROM gql_internal.graph_element_tables et JOIN gql_internal.graphs g USING(graph_id)
 WHERE g.graph_name='endpoint_reference' AND et.element_kind='VERTEX')

statement ok
SET VARIABLE endpoint_reference_edges=(SELECT et.schema_name||'.'||et.table_name
 FROM gql_internal.graph_element_tables et JOIN gql_internal.graphs g USING(graph_id)
 WHERE g.graph_name='endpoint_reference' AND et.element_kind='EDGE')

statement ok
CREATE MACRO endpoint_labels(v) AS list_sort(list_distinct(list_transform(
 list_filter(coalesce(v,[]), lambda x: x IS NOT NULL AND x<>''), lambda x: lower(x))))

statement ok
CREATE TEMP VIEW endpoint_reference_vertices AS
SELECT __gql_id, endpoint_labels(__gql_label) AS labels
FROM query_table(getvariable('endpoint_reference_vertices'))

statement ok
CREATE TEMP VIEW endpoint_reference_populations AS
SELECT labels, count(*)::UBIGINT AS population FROM endpoint_reference_vertices GROUP BY labels

statement ok
CREATE TEMP VIEW endpoint_reference_counts AS
SELECT s.labels AS source_labels, lower(e.__gql_type) AS edge_label, t.labels AS target_labels,
 count(*)::UBIGINT AS edge_count, count(DISTINCT s.__gql_id)::UBIGINT AS source_active_vertices,
 count(DISTINCT t.__gql_id)::UBIGINT AS target_active_vertices
FROM query_table(getvariable('endpoint_reference_edges')) e
JOIN endpoint_reference_vertices s ON e.__gql_source_id=s.__gql_id
JOIN endpoint_reference_vertices t ON e.__gql_target_id=t.__gql_id
GROUP BY s.labels,lower(e.__gql_type),t.labels

statement ok
CALL gql_build_csr('endpoint_reference', endpoint_statistics := true)

query I
WITH expected AS (
 SELECT c.*,s.population AS source_population,t.population AS target_population
 FROM endpoint_reference_counts c
 JOIN endpoint_reference_populations s ON s.labels=c.source_labels
 JOIN endpoint_reference_populations t ON t.labels=c.target_labels
), actual AS (
 SELECT list_sort(source_labels) AS source_labels,edge_label,list_sort(target_labels) AS target_labels,
 edge_count,source_active_vertices,target_active_vertices,source_population,target_population
 FROM gql_csr_endpoint_stats('endpoint_reference')
)
SELECT count(*) FROM (
 (SELECT * FROM expected EXCEPT ALL SELECT * FROM actual)
 UNION ALL
 (SELECT * FROM actual EXCEPT ALL SELECT * FROM expected)
) differences
----
0

query I
SELECT sum(edge_count) FROM gql_csr_endpoint_stats('endpoint_reference')
----
3002
