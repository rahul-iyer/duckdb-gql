# name: test/sql/gql_basic_query.test
# description: Basic GQL result shaping, optional matching, functions, and aggregation on native DuckDB operators
# group: [gql]

require duckgql

statement ok
COPY (
    SELECT * FROM (VALUES
        ('1', 'Ada', 42, 'Person'),
        ('2', 'Grace', 35, 'Person'),
        ('3', 'Ada', 30, 'Person')
    ) vertices(":ID", "name:string", "age:int", ":LABEL")
) TO '__TEST_DIR__/gql_basic_vertices.csv' (FORMAT CSV, HEADER)

statement ok
COPY (
    SELECT * FROM (VALUES
        ('1', '2', 'KNOWS'),
        ('2', '3', 'KNOWS')
    )
    edges(":START_ID", ":END_ID", ":TYPE")
) TO '__TEST_DIR__/gql_basic_edges.csv' (FORMAT CSV, HEADER)

statement ok
CREATE GRAPH basic_queries ANY

statement ok
COPY GRAPH basic_queries FROM (
    VERTICES '__TEST_DIR__/gql_basic_vertices.csv',
    EDGES '__TEST_DIR__/gql_basic_edges.csv'
) FORMAT GRAPH

statement ok
SESSION SET GRAPH basic_queries

query T rowsort
MATCH (person:Person)
RETURN DISTINCT person.name AS name
----
Ada
Grace

query T
MATCH (person:Person) WHERE person.age = 42
RETURN person
----
{'vertex_id': 1, '__gql_labels': person, 'age': 42, 'name': Ada}

query T rowsort
MATCH (source:Person)-[relationship:KNOWS]->(target:Person)
RETURN relationship
----
{'edge_id': 1, '__gql_type': knows, '__gql_source': 1, '__gql_target': 2}
{'edge_id': 2, '__gql_type': knows, '__gql_source': 2, '__gql_target': 3}

query T
OPTIONAL MATCH (person:Missing)
RETURN person
----
NULL

# A predicate owned by a leading OPTIONAL MATCH stays on the right side of
# LEFT_APPLY, so a failed predicate still preserves the identity input row.
query T
OPTIONAL MATCH (person:Person) WHERE person.age > 100
RETURN person.name AS name
----
NULL

query T
OPTIONAL MATCH (person:Person)
FILTER person.age > 100
RETURN person.name AS name
----
NULL

query T
MATCH p = (source:Person)-[relationship:KNOWS]->(target:Person)
WHERE source.age = 42
RETURN p
----
{'nodes': [{'vertex_id': 1, '__gql_labels': person, 'age': 42, 'name': Ada}, {'vertex_id': 2, '__gql_labels': person, 'age': 35, 'name': Grace}], 'edges': [{'edge_id': 1, '__gql_type': knows, '__gql_source': 1, '__gql_target': 2}]}

query T
OPTIONAL MATCH p = (source:Missing)-[relationship]->(target)
RETURN p
----
NULL

query T
MATCH p = (person:Person) WHERE person.age = 42
RETURN p
----
{'nodes': [{'vertex_id': 1, '__gql_labels': person, 'age': 42, 'name': Ada}], 'edges': []}

query T
MATCH p = (destination:Person)<-[relationship:KNOWS]-(source:Person)
WHERE destination.age = 35
RETURN p
----
{'nodes': [{'vertex_id': 2, '__gql_labels': person, 'age': 35, 'name': Grace}, {'vertex_id': 1, '__gql_labels': person, 'age': 42, 'name': Ada}], 'edges': [{'edge_id': 1, '__gql_type': knows, '__gql_source': 1, '__gql_target': 2}]}

query TI
MATCH (person:Person)
RETURN person.name AS name, element_id(person) AS person_id
ORDER BY name DESC, person_id ASC
OFFSET 1
LIMIT 1
----
Ada	1

query TTTTII rowsort
MATCH (person:Person) WHERE person.name = 'Ada'
RETURN LOWER(person.name) AS lower_name,
       UPPER(person.name) AS upper_name,
       LEFT(person.name, 2) AS left_name,
       RIGHT(person.name, 2) AS right_name,
       CHAR_LENGTH(person.name) AS name_length,
       MOD(person.age, 10) AS age_mod
----
ada	ADA	Ad	da	3	0
ada	ADA	Ad	da	3	2

query TT rowsort
MATCH (person:Person) WHERE person.name = 'Ada'
RETURN TRIM('  Ada  ') AS trimmed, person.name || ' Lovelace' AS full_name
----
Ada	Ada Lovelace
Ada	Ada Lovelace

query T
OPTIONAL MATCH (person:Missing)
RETURN person.name AS name
----
NULL

query T rowsort
OPTIONAL MATCH (person:Person)
RETURN person.name AS name
----
Ada
Ada
Grace

query TT
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(middle)-[]->(destination)
RETURN middle.name AS middle_name, destination.name AS destination_name
----
Grace	Ada

query TT
MATCH (source:Person) WHERE source.age = 35
OPTIONAL MATCH (source)-[]->(middle)-[]->(destination)
RETURN middle.name AS middle_name, destination.name AS destination_name
----
NULL	NULL

query TT
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(middle), (middle)-[]->(destination)
RETURN middle.name AS middle_name, destination.name AS destination_name
----
Grace	Ada

query TT
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(middle)
OPTIONAL MATCH (middle)-[]->(destination) WHERE destination.age > 100
RETURN middle.name AS middle_name, destination.name AS destination_name
----
Grace	NULL

# A leading OPTIONAL MATCH is a UNIT-backed LEFT_APPLY. A later mandatory
# stage consumes its null-extended row without changing clause order.
query TT
OPTIONAL MATCH (missing:Missing)
MATCH (person:Person) WHERE person.age = 42
RETURN missing.name AS missing_name, person.name AS person_name
----
NULL	Ada

# Mandatory stages can correlate with bindings introduced by an earlier
# optional stage. A successful optional binding participates normally.
query TT
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(middle:Person)
MATCH (middle)-[]->(destination:Person)
RETURN middle.name AS middle_name, destination.name AS destination_name
----
Grace	Ada

# A mandatory stage that consumes a null-extended optional binding eliminates
# that row, matching ordinary inner-apply semantics.
query T
MATCH (source:Person) WHERE source.age = 35
OPTIONAL MATCH (source)-[]->(middle:Person) WHERE middle.age > 100
MATCH (middle)-[]->(destination:Person)
RETURN destination.name AS destination_name
----

# An optional stage may constrain only existing bindings and introduce no new
# variables. Failure preserves the left binding rather than replacing it.
query T
MATCH (person:Person) WHERE person.age = 42
OPTIONAL MATCH (person:Person) WHERE person.age > 100
RETURN person.name AS person_name
----
Ada

# LET terminates optional predicate ownership. This FILTER is post-join and
# therefore removes the row instead of turning the failed predicate into a
# null-extended optional result.
query T
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(destination:Person)
LET destination_age = destination.age
FILTER destination_age > 100
RETURN source.name AS source_name
----

# Linear FILTER clauses are bound in source order. Each MATCH extends the
# current scope, and a later FILTER can see both earlier and newly introduced
# variables.
query TT
MATCH (source:Person)
FILTER source.age = 42
MATCH (source)-[]->(target:Person)
FILTER target.age = 35
RETURN source.name AS source_name, target.name AS target_name
----
Ada	Grace

# A predicate that only needs the left input can move below INNER_APPLY.
query TT
MATCH (source:Person)
MATCH (source)-[]->(target:Person)
FILTER source.age = 42
RETURN source.name AS source_name, target.name AS target_name
----
Ada	Grace

# A correlated predicate that needs both sides can move into the right MATCH
# stage and become an INNER JOIN condition.
query TT rowsort
MATCH (source:Person)
MATCH (source)-[]->(target:Person)
FILTER source.age > target.age
RETURN source.name AS source_name, target.name AS target_name
----
Ada	Grace
Grace	Ada

# FILTER ownership also follows clause order across OPTIONAL MATCH stages.
query TT
MATCH (source:Person) WHERE source.age = 42
OPTIONAL MATCH (source)-[]->(destination:Person)
FILTER destination.age > 100
RETURN source.name AS source_name, destination.name AS destination_name
----
Ada	NULL

# A FILTER cannot resolve a variable introduced by a later MATCH clause.
statement error
MATCH (source:Person)
FILTER future.age = 35
MATCH (source)-[]->(future:Person)
RETURN future.name AS name
----
<REGEX>:.*GQL binding variable 'future' is not defined.*

