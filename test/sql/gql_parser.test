# name: test/sql/gql_parser.test
# description: GQL parser validation, SQL coexistence, normalization, and feature boundaries
# group: [sql]

require duckgql

query I
SELECT 42
----
42

query IT
CREATE /* lifecycle command trivia */ GRAPH MiXeD ANY;
----
true	mixed

query T
SELECT graph_name FROM gql_graphs()
----
mixed

statement error
CREATE GRAPH broken
----
<REGEX>:.*GQL parser error.*

statement error
CREATE GRAPH typed_graph { (Person :Person {name STRING}) }
----
<REGEX>:.*GQL feature not implemented: non-inline typed graph creation \(line 1, column 0\).*

statement error
CREATE GRAPH broken
RETURN
----
<REGEX>:.*GQL parser error at line 2, column 0.*

query IT
CREATE PROPERTY GRAPH property_spelling ANY
----
true	property_spelling

query IT
DROP PROPERTY GRAPH property_spelling
----
true	property_spelling

statement error
MATCH (n) RETURN n
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

# Dispatch uses the same trivia rules as the GQL lexer between keywords and
# before an INSERT pattern.
statement error
OPTIONAL
/* match keyword trivia */ MATCH (n)
RETURN n
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

statement error
INSERT
/* pattern trivia */ (:Person)
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before mutation.*

# Leading lexical trivia must not make the parser override miss GQL.
statement error
/* leading GQL comment */
MATCH (n) RETURN n
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

statement error
// leading solidus comment
MATCH (n) RETURN n
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

# Delimited graph names use the same lifecycle path as regular graph names.
query IT
CREATE GRAPH `Mixed Graph` ANY
----
true	Mixed Graph

query IT
SESSION SET GRAPH "Mixed Graph"
----
true	Mixed Graph

query IT
DROP GRAPH `Mixed Graph`
----
true	Mixed Graph

# Supported delimited labels, property names, and RETURN aliases proceed far
# enough to require a selected graph.
statement error
MATCH (n:`Person Label`) RETURN n
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

statement error
MATCH (n) RETURN n.`First Name`
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

statement error
MATCH (n) RETURN n AS `Node Alias`
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before MATCH.*

statement error
INSERT (n:`Person Label`)
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before mutation.*

statement error
INSERT (:Person {`First Name`: 'Ada'})
----
<REGEX>:.*No graph selected; use SESSION SET GRAPH before mutation.*

# Parser overrides receive the complete query string. Split mixed batches before
# lowering so a lifecycle statement cannot force a following MATCH down the
# legacy extension-statement plan path.
statement error
SESSION SET GRAPH mixed; MATCH (n) RETURN n;
----
<REGEX>:.*Graph 'mixed' has no native tables.*

query IT
DROP
/* lifecycle command trivia */ GRAPH mixed
----
true	mixed
