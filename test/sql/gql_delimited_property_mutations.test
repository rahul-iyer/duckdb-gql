# name: test/sql/gql_delimited_property_mutations.test
# description: Delimited property names in SET assignments, SET maps, and REMOVE
# group: [sql]

require duckgql

statement ok
COPY (
    SELECT * FROM (VALUES
        ('p1', 'Person', 'Ada', 1815, 'Initial Display', 'Initial Tick', 'initial assignment'),
        ('p2', 'Person', 'Grace', 1905, 'Initial Display', 'Initial Tick', 'initial map'),
        ('p3', 'Person', 'Katherine', 1918, 'Initial Display', 'Initial Tick', 'initial remove')
    ) nodes("external_id:ID(People)", ":LABEL", "First Name:string", "Birth Year:int",
            "Display ""Name"":string", "Tick`Property:string", "regular_name:string")
) TO '__TEST_DIR__/gql_delimited_property_mutation_nodes.csv' (FORMAT CSV, HEADER)

statement ok
COPY (
    SELECT * FROM (VALUES
        ('p1', 'p2', 'KNOWS')
    ) relationships(":START_ID(People)", ":END_ID(People)", ":TYPE")
) TO '__TEST_DIR__/gql_delimited_property_mutation_edges.csv' (FORMAT CSV, HEADER)

statement ok
CREATE GRAPH delimited_property_mutations ANY

statement ok
COPY GRAPH delimited_property_mutations FROM (
    VERTICES '__TEST_DIR__/gql_delimited_property_mutation_nodes.csv',
    EDGES '__TEST_DIR__/gql_delimited_property_mutation_edges.csv'
) FORMAT GRAPH

statement ok
SESSION SET GRAPH delimited_property_mutations

# SET assignments accept both delimiter forms. Doubled delimiters are unquoted
# through the same identifier transformation used by property references.
statement ok
MATCH (person:Person) WHERE person.external_id = 'p1'
SET person."First Name" = 'Augusta Ada',
    person.`Birth Year` = person.`Birth Year` + 1,
    person."Display ""Name""" = 'Double Quote',
    person.`Tick``Property` = 'Backtick',
    person.regular_name = 'regular assignment'

query TITTT
MATCH (person:Person) WHERE person.external_id = 'p1'
RETURN person."First Name", person.`Birth Year`, person."Display ""Name""",
       person.`Tick``Property`, person.regular_name
----
Augusta Ada	1816	Double Quote	Backtick	regular assignment

# SET maps accept regular and delimited property keys together. The standard
# replacement form clears mapped properties before applying the supplied map.
statement ok
MATCH (person:Person) WHERE person.external_id = 'p2'
SET person = {
    "First Name": 'Grace Hopper',
    `Birth Year`: 1906,
    "Display ""Name""": 'Rear Admiral',
    `Tick``Property`: 'Compiler',
    regular_name: 'regular map'
}

query TITTT
MATCH (person:Person) WHERE person."First Name" = 'Grace Hopper'
RETURN person."First Name", person.`Birth Year`, person."Display ""Name""",
       person.`Tick``Property`, person.regular_name
----
Grace Hopper	1906	Rear Admiral	Compiler	regular map

# REMOVE accepts both delimiter forms and leaves the element available through
# an unrelated regular property.
statement ok
MATCH (person:Person) WHERE person.external_id = 'p3'
REMOVE person."First Name", person.`Birth Year`, person."Display ""Name""",
       person.`Tick``Property`, person.regular_name

query TITTT
MATCH (person:Person) WHERE person.external_id = 'p3'
RETURN person."First Name", person.`Birth Year`, person."Display ""Name""",
       person.`Tick``Property`, person.regular_name
----
NULL	NULL	NULL	NULL	NULL

# Binding variables remain regular identifiers as required by the grammar.
statement error
MATCH (person:Person)
SET "person"."First Name" = 'Rejected'
----
<REGEX>:.*GQL parser error.*

statement error
MATCH (person:Person)
SET "person" = {"First Name": 'Rejected'}
----
<REGEX>:.*GQL parser error.*

statement error
MATCH (person:Person)
REMOVE "person"."First Name"
----
<REGEX>:.*GQL parser error.*
