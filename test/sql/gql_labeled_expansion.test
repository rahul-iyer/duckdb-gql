# name: test/sql/gql_labeled_expansion.test
# description: CSR expansion filters on required neighbor labels with bag, optional, and conjunction semantics intact
# group: [gql]

require duckgql

statement ok
COPY (SELECT * FROM (VALUES
 (1,'Hub',1),(2,'Post;Message',2),(3,'Comment;Message',3),(4,'Post;Message',4),(5,'Other',5)
) v(":ID",":LABEL","id:int")) TO '{TEST_DIR}/labeled_nodes.csv' (HEADER)

statement ok
COPY (SELECT * FROM (VALUES
 (1,2,'R'),(1,2,'R'),(1,3,'R'),(1,4,'R'),(1,5,'R'),(2,1,'R'),(3,1,'S'),(5,1,'S')
) e(":START_ID",":END_ID",":TYPE")) TO '{TEST_DIR}/labeled_edges.csv' (HEADER)

statement ok
CREATE GRAPH labeled ANY

statement ok
COPY GRAPH labeled FROM (VERTICES '{TEST_DIR}/labeled_nodes.csv', EDGES '{TEST_DIR}/labeled_edges.csv') FORMAT GRAPH

statement ok
SESSION SET GRAPH labeled

statement ok
CALL gql_create_property_index('labeled', 'id')

statement ok
CALL gql_build_csr('labeled')

foreach optimizer legacy cost

statement ok
SET gql_optimizer='{optimizer}'

# The neighbor label filters; parallel edges keep their multiplicity.
query I rowsort
MATCH (a:Hub)-[:R]->(b:Post) WHERE a.id=1 RETURN b.id
----
2
2
4

# A label shared by several kinds of vertex keeps all of them.
query I rowsort
MATCH (a:Hub)-[:R]->(b:Message) WHERE a.id=1 RETURN b.id
----
2
2
3
4

# Every conjunct still applies, including those the expansion does not test.
query I rowsort
MATCH (a:Hub)-[:R]->(b:Message&Post) WHERE a.id=1 RETURN b.id
----
2
2
4

query I rowsort
MATCH (a:Hub)-[:R]->(b:Post&Comment) WHERE a.id=1 RETURN b.id
----

# Case-insensitive labels, unknown labels, and no label at all.
query I rowsort
MATCH (a:Hub)-[:R]->(b:pOsT) WHERE a.id=1 RETURN b.id
----
2
2
4

query I
MATCH (a:Hub)-[:R]->(b:Nonexistent) WHERE a.id=1 RETURN b.id
----

query I
MATCH (a:Hub)-[:R]->(b) WHERE a.id=1 RETURN count(*)
----
5

# Reverse direction applies the label to the far endpoint, not the seed.
query I rowsort
MATCH (a:Hub)<-[:S]-(b:Comment) WHERE a.id=1 RETURN b.id
----
3

query I rowsort
MATCH (b:Comment)-[:S]->(a:Hub) WHERE a.id=1 RETURN b.id
----
3

# Filtering all neighbors of OPTIONAL MATCH still null-extends the outer row.
query II
MATCH (a:Hub) WHERE a.id=1
OPTIONAL MATCH (a)-[:R]->(b:Nonexistent)
RETURN a.id, b.id
----
1	NULL

query II rowsort
MATCH (a:Hub) WHERE a.id=1
OPTIONAL MATCH (a)-[:R]->(b:Comment)
RETURN a.id, b.id
----
1	3

# A seed without qualifying neighbors is dropped; others in its batch stay aligned.
query II rowsort
MATCH (a:Message) MATCH (a)-[:R]->(b:Hub) RETURN a.id, b.id
----
2	1

query II rowsort
MATCH (a:Hub)-[:R]->(b:Message) WHERE a.id=1
OPTIONAL MATCH (b)-[:R]->(c:Hub)
RETURN b.id, c.id
----
2	1
2	1
3	NULL
4	NULL

# Multi-hop chain with labels on each step.
query I
MATCH (a:Post)-[:R]->(b:Hub)-[:R]->(c:Comment) RETURN c.id
----
3

endloop

# The original function keeps its four-field signature.
query I
SELECT count(*) FROM (VALUES (1::UBIGINT)) seed(id),
LATERAL gql_csr_expand(struct_pack(graph_name := 'labeled', vertex_id := seed.id, direction := 'out', edge_label := 'r')) e
----
5
