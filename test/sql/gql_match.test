# name: test/sql/gql_match.test
# description: Direct GQL node and directed-edge MATCH lowered to native DuckDB relational plans
# group: [gql]

require gql

statement error
MATCH (n) RETURN element_id(n)
----
No graph selected; use SESSION SET GRAPH before MATCH

statement ok
CREATE GRAPH social ANY

statement ok
SESSION SET GRAPH social

statement ok
INSERT (:Person {name: 'Ada', age: 42, active: true})-[:KNOWS {since: 2020}]->(:Person {name: 'Grace'})

query I rowsort
MATCH (n) RETURN element_id(n)
----
1
2

query I rowsort
MATCH (n:Person) RETURN element_id(n) AS person_id
----
1
2

# MATCH lowering consumes the OpenGQL parse tree, including the standard IS
# label spelling, instead of reparsing the source with regular expressions.
query I rowsort
MATCH (n IS Person) RETURN element_id(n) AS person_id
----
1
2

query I rowsort
MATCH /* between clause and pattern */ (n /* in pattern */ : Person)
RETURN /* before expression */ element_id(n) AS person_id
----
1
2

query I
MATCH (n:Team) RETURN element_id(n)
----

query III
MATCH (a:Person)-[e:KNOWS]->(b:Person)
RETURN element_id(a) AS source_id, element_id(e) AS edge_id, element_id(b) AS target_id
----
1	3	2

query TTT
MATCH (a:Person)-[e:KNOWS]->(b:Person)
RETURN a.name AS source_name, e.since AS since, b.name AS target_name
----
Ada	2020	Grace

# A left-pointing directed pattern reverses the native endpoint joins while
# preserving binding order as written in the GQL pattern.
query TTT
MATCH (target:Person)<-[e:KNOWS]-(source:Person)
RETURN source.name AS source_name, e.since AS since, target.name AS target_name
----
Ada	2020	Grace

query TT rowsort
MATCH (n:Person) RETURN n.name AS name, n.age AS age
----
Ada	42
Grace	NULL

# Multiple fixed patterns are one native binding table. Independent variables
# produce the relational Cartesian product; WHERE can correlate/filter it.
query TT rowsort
MATCH (a:Person), (b:Person) RETURN a.name AS a_name, b.name AS b_name
----
Ada	Ada
Ada	Grace
Grace	Ada
Grace	Grace

query II
MATCH (a:Person), (b:Person)
WHERE a.name = 'Ada' AND b.name = 'Grace'
RETURN element_id(a) AS a_id, element_id(b) AS b_id
----
1	2

# Reusing a variable across patterns reuses its binding slot rather than
# generating independent candidates.
query I rowsort
MATCH (n:Person), (n:Person) RETURN element_id(n) AS node_id
----
1
2

query TT
MATCH (a:Person)-[e:KNOWS]->(b:Person), (c:Person)
WHERE c.name = 'Ada'
RETURN b.name AS target_name, c.name AS selected_name
----
Grace	Ada

# Mixed data-modifying pipelines are rejected until their writes can consume
# this binding table inside the caller transaction. They must never degrade to
# a standalone INSERT.
statement error
MATCH (a:Person), (b:Person) INSERT (a)-[:KNOWS]->(b)
----
<REGEX>:.*GQL feature not implemented: MATCH with data modification pipeline.*

query II
SELECT vertex_count, edge_count FROM gql_graphs() WHERE graph_name = 'social'
----
2	1

# Graph-pattern WHERE is transformed into the owned expression AST, bound
# against MATCH variables, and executed as a logical filter before projection.
query T
MATCH (n:Person) WHERE n.age >= 40 RETURN n.name AS name
----
Ada

# Missing open-graph properties are NULL and obey three-valued predicate
# semantics rather than being treated as false scalar values.
query T
MATCH (n:Person) WHERE n.age IS NULL RETURN n.name AS name
----
Grace

query T
MATCH (n:Person) WHERE n.age < 40 OR n.age IS NULL RETURN n.name AS name
----
Grace

query T
MATCH (n:Person) WHERE NOT (n.age IS NULL) AND n.age + 1 = 43 RETURN n.name AS name
----
Ada

query T
MATCH (n:Person) WHERE n.active RETURN n.name AS name
----
Ada

query T
MATCH (n:Person) WHERE n.active XOR false RETURN n.name AS name
----
Ada

# Linear FILTER uses the same search-condition AST and becomes a distinct
# logical filter operator after MATCH.
query T
MATCH (n:Person) FILTER n.name = 'Grace' RETURN n.name AS name
----
Grace

query T
MATCH (n:Person) FILTER WHERE n.age IS NOT NULL FILTER n.age >= 40 RETURN n.name AS name
----
Ada

query T
MATCH (a:Person)-[e:KNOWS]->(b:Person) WHERE e.since = 2020 RETURN b.name AS name
----
Grace

statement error
MATCH (n:Person) WHERE missing.age = 42 RETURN n.name
----
<REGEX>:.*GQL binding variable 'missing' is not defined.*

statement error
MATCH (n:Person) WHERE n.name RETURN n.name
----
<REGEX>:.*GQL predicate expected BOOLEAN, found VARCHAR.*

query II
MATCH (a)-[e]->(b) RETURN element_id(a), element_id(b)
----
1	2

query II
MATCH (a)-[:KNOWS]->(b) RETURN element_id(a), element_id(b)
----
1	2

query I
MATCH (a)-[:MISSING]->(b) RETURN element_id(a)
----

# Fixed MATCH stays relational. The explicit CSR inspection API builds and
# caches its own versioned snapshot independently.
query I
SELECT build_count FROM gql_csr_stats('social')
----
1

statement ok
INSERT (:Person {name: 'Linus'})-[:KNOWS]->(:Person {name: 'Margaret'})

query III rowsort
MATCH (a:Person)-[e:KNOWS]->(b:Person)
RETURN element_id(a), element_id(e), element_id(b)
----
1	3	2
4	6	5

query II
SELECT graph_version, build_count FROM gql_csr_stats('social')
----
2	2

# Explicit multi-hop paths remain native DuckDB joins. Direction belongs to
# each edge occurrence, so one path can mix right- and left-pointing edges.
statement ok
CREATE GRAPH routes ANY

statement ok
SESSION SET GRAPH routes

statement ok
INSERT (:City {name: 'A'})-[:ROAD]->(:City {name: 'B'})<-[:ROAD]-(:City {name: 'C'})-[:ROAD]->(:City {name: 'D'})

query TTTT
MATCH (a:City)-[ab:ROAD]->(b:City)<-[cb:ROAD]-(c:City)-[cd:ROAD]->(d:City)
RETURN a.name AS a_name, b.name AS b_name, c.name AS c_name, d.name AS d_name
----
A	B	C	D

query TT
MATCH (d:City)<-[cd:ROAD]-(c:City)-[cb:ROAD]->(b:City)<-[ab:ROAD]-(a:City)
WHERE b.name = 'B' AND c.name = 'C'
RETURN a.name AS source_name, d.name AS target_name
----
A	D

# Anonymous nodes and edges still receive internal binding slots and therefore
# participate in the same native joins without becoming visible variables.
query I rowsort
MATCH (:City)-[:ROAD]->(:City) RETURN 1 AS one
----
1
1
1

statement ok
DROP GRAPH routes

# Exact fixed edge quantifiers are retained in the typed AST and expanded by
# the binder into an ordinary fixed native-DuckDB join chain. The source and
# destination variables stay scalar; anonymous internal vertices and repeated
# edges receive private binding slots.
statement ok
CREATE GRAPH quantified_paths ANY

statement ok
SESSION SET GRAPH quantified_paths

statement ok
INSERT (:City {name: 'A'})-[:ROAD]->(:City {name: 'B'})-[:ROAD]->(:City {name: 'C'})-[:ROAD]->(:City {name: 'D'})

query TT rowsort
MATCH (source:City)-[:ROAD]->{1}(target:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	B
B	C
C	D

query TT rowsort
MATCH (source:City)-[:ROAD]->{2}(target:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	C
B	D

query TT
MATCH (source:City)-[:ROAD]->{3}(target:City)
WHERE source.name = 'A'
RETURN source.name AS source_name, target.name AS target_name
----
A	D

# Left-pointing spelling repeats the direction of every expanded edge.
query TT rowsort
MATCH (target:City)<-[:ROAD]-{2}(source:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	C
B	D

# Finite ranges become one native fixed-plan branch per permitted length. UNION
# ALL preserves one result per matched path instead of deduplicating endpoints.
query TT rowsort
MATCH (source:City)-[:ROAD]->{1,3}(target:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	B
A	C
A	D
B	C
B	D
C	D

query TT rowsort
MATCH (target:City)<-[:ROAD]-{1,2}(source:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	B
A	C
B	C
B	D
C	D

# Multiple finite ranges enumerate the Cartesian product of their lengths.
# A-to-D appears twice because the intermediate binding can be B or C.
query TT rowsort
MATCH (source:City)-[:ROAD]->{1,2}(middle:City)-[:ROAD]->{1,2}(target:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	C
A	D
A	D
B	D

query TT rowsort
MATCH (source:City)-[:ROAD]->{2,2}(target:City)
RETURN source.name AS source_name, target.name AS target_name
----
A	C
B	D

# Zero-inclusive finite bounds and quantified group variables remain explicit
# errors. Native recursive coverage for *, +, and {n,} lives in
# gql_recursive_match.test.
statement error
MATCH (source)-[:ROAD]->{,3}(target) RETURN element_id(source)
----
<REGEX>:.*GQL feature not implemented: path quantifier bounds outside the supported range 1\.\.64.*

statement error
MATCH (source)-[:ROAD]->{3,2}(target) RETURN element_id(source)
----
<REGEX>:.*GQL path quantifier lower bound must be between 1 and its upper bound.*

statement error
MATCH (source)-[:ROAD]->{1,9}(middle)-[:ROAD]->{1,9}(target) RETURN element_id(source)
----
<REGEX>:.*GQL finite path quantifiers produce more than 64 native alternatives.*

statement error
MATCH (source)-[roads:ROAD]->{2}(target) RETURN element_id(source)
----
<REGEX>:.*GQL feature not implemented: group variables in quantified paths.*

statement error
MATCH (source)-[:ROAD]->{0}(target) RETURN element_id(source)
----
<REGEX>:.*GQL feature not implemented: fixed path quantifier outside the supported range 1\.\.64.*

statement error
MATCH (source)-[:ROAD]->{65}(target) RETURN element_id(source)
----
<REGEX>:.*GQL feature not implemented: fixed path quantifier outside the supported range 1\.\.64.*

statement ok
DROP GRAPH quantified_paths

statement ok
SESSION SET GRAPH social

statement error
MATCH (a)-[e]-(b) RETURN element_id(a)
----
<REGEX>:.*GQL feature not implemented: MATCH pattern or projection.*

statement error
MATCH (a)-[e]->(b) RETURN element_id(missing)
----
<REGEX>:.*GQL binding variable 'missing' is not defined.*

query I rowsort
MATCH (n:Person) RETURN DISTINCT element_id(n)
----
1
2
4
5

statement ok
DROP GRAPH social
