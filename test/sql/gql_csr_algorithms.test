# Reciprocal edges, parallel edges, and self-loops do not multiply triangles
# in the simple undirected projection.
query IT
SESSION SET GRAPH algo_graph
----
true	algo_graph

statement ok
MATCH (source:node), (target:node)
WHERE source.name = 'three' AND target.name = 'four'
INSERT (target)-[:route]->(source)

statement ok
MATCH (source:node), (target:node)
WHERE source.name = 'three' AND target.name = 'four'
INSERT (source)-[:route]->(target)

statement ok
MATCH (source:node) WHERE source.name = 'three'
INSERT (source)-[:route]->(source)

statement ok
CALL gql_build_csr('algo_graph')

query II
SELECT sum(triangle_count), max(global_triangle_count)
FROM system.algo.triangle_count('algo_graph')
----
3	1

statement error
CALL algo.bfs('algo_graph', 999)
----
start vertex 999 does not exist

statement error
CALL algo.bfs('algo_graph', 1, direction := 'sideways')
----
direction must be 'out', 'in', or 'both'

# Conservative graph-version invalidation rejects stale snapshots. Rebuilding
# is explicit even when a mutation only changed properties.
statement ok
MATCH (n:node) SET n.name = n.name

statement error
CALL algo.bfs('algo_graph', 1)
----
run CALL gql_build_csr('algo_graph') first

statement ok
CALL gql_build_csr('algo_graph')

statement ok
BEGIN

statement error
CALL algo.bfs('algo_graph', 1)
----
CSR algorithms are not eligible inside an explicit transaction

statement ok
ROLLBACK

# Managed IDs are normally dense. After a delete and sequence-backed insert
# create a hole, construction falls back to the sparse ID map without changing
# the public traversal contract.
statement ok
MATCH (n:node) WHERE n.name = 'isolated'
DETACH DELETE n

statement ok
INSERT (:node {name: 'replacement'})

statement ok
CALL gql_build_csr('algo_graph')

query IIIII
CALL algo.bfs('algo_graph', 7)
----
7	0	NULL	NULL	0

query II
SELECT neighbor_width_bytes, vertex_ids_explicit
FROM gql_csr_stats('algo_graph')
----
4	true

# Uniform edge labels are represented once rather than once per stored arc.
statement ok
UPDATE gql_data.graph_1_edges SET __gql_type = 'route'

statement ok
CALL gql_build_csr('algo_graph')

query I
SELECT edge_labels_uniform
FROM gql_csr_stats('algo_graph')
----
true

query I
SELECT count(*) FROM system.algo.bfs('algo_graph', 1, edge_label := 'route')
----
5

query I
SELECT count(*) FROM system.algo.bfs('algo_graph', 1, edge_label := 'express')
----
1
