# name: test/sql/gql_connected_expansion.test
# description: Independent CSR branches meet at graph joins before multiplying results
# group: [gql]

require duckgql

statement ok
COPY (
    SELECT i AS ":ID", i AS "id:int",
           CASE WHEN i <= 2 THEN 'Anchor' WHEN i <= 102 OR i = 203 THEN 'Mid' ELSE 'Leaf' END AS ":LABEL"
    FROM range(1, 204) t(i)
) TO '__TEST_DIR__/connected_nodes.csv' (HEADER)

statement ok
COPY (
    SELECT 1 AS ":START_ID", i AS ":END_ID", 'A' AS ":TYPE" FROM range(3, 103) t(i)
    UNION ALL SELECT i, i + 100, 'C' FROM range(3, 103) t(i)
    UNION ALL SELECT i + 100, 2, 'B' FROM range(3, 103) t(i)
    UNION ALL SELECT 1, 3, 'A'
    UNION ALL SELECT 1, 203, 'A'
) TO '__TEST_DIR__/connected_edges.csv' (HEADER)

statement ok
CREATE GRAPH connected_expansion ANY

statement ok
COPY GRAPH connected_expansion FROM (VERTICES '__TEST_DIR__/connected_nodes.csv', EDGES '__TEST_DIR__/connected_edges.csv') FORMAT GRAPH

statement ok
CALL gql_create_property_index('connected_expansion', 'id')

statement ok
CALL gql_build_csr('connected_expansion')

statement ok
SESSION SET GRAPH connected_expansion

statement ok
PRAGMA enable_profiling='json'

statement ok
PRAGMA profiling_output='__TEST_DIR__/connected_expansion.json'

# The branches anchored at left_node and right_node each have about 100 rows.
# Connecting them by C must preserve parallel-edge multiplicity, without first
# constructing their 10,000-row Cartesian product inside a dependent join.
query II
MATCH (left_node:Anchor)-[:A]->(middle:Mid),
      (endpoint:Leaf)-[:B]->(right_node:Anchor),
      (middle)-[:C]->(endpoint)
WHERE left_node.id = 1 AND right_node.id = 2
RETURN count(*), count(DISTINCT middle.id)
----
101	100

statement ok
PRAGMA disable_profiling

query I
SELECT CAST(regexp_extract(content, '"total_intermediate_rows"\s*:\s*([0-9]+)', 1) AS BIGINT) < 5000
FROM read_text('__TEST_DIR__/connected_expansion.json')
----
true

# Reversed written edge direction retains the same multiplicities.
query I
MATCH (middle:Mid)<-[:A]-(left_node:Anchor),
      (right_node:Anchor)<-[:B]-(endpoint:Leaf),
      (middle)-[:C]->(endpoint)
WHERE left_node.id = 1 AND right_node.id = 2
RETURN count(*)
----
101

# An OPTIONAL stage must retain the unmatched left row as a null extension.
query II
MATCH (left_node:Anchor)-[:A]->(middle:Mid) WHERE left_node.id = 1
OPTIONAL MATCH (middle)-[:C]->(endpoint:Leaf),
               (endpoint)-[:B]->(right_node:Anchor)
WHERE right_node.id = 2
RETURN count(*), count(endpoint.id)
----
102	101

# Disconnected branches still have their intentional Cartesian multiplicity.
query I
MATCH (left_node:Anchor)-[:A]->(middle:Mid),
      (endpoint:Leaf)-[:B]->(right_node:Anchor)
WHERE left_node.id = 1 AND right_node.id = 2
RETURN count(*)
----
10200
